---
const currentPath = Astro.url.pathname;
const links = [
  { href: '/', label: '首页' },
  { href: '/about/', label: '关于我' },
  { href: '/blog/', label: '技术博客' },
  { href: '/notes/', label: '笔记' },
  { href: '/knowledge/', label: '知识库' },
  { href: '/skills/', label: 'Skill' },
];
---
<header class="site-header wrap">
  <a class="brand" href="/" aria-label="返回首页"><span class="brand-mark">B</span><span>Boyang Wang<span class="brand-sub">PERSONAL TECH HUB</span></span></a>
  <nav id="primary-navigation" aria-label="主导航">
    {links.map((link) => {
      const isActive = currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href));
      return <a class:list={["nav-link", { active: isActive }]} href={link.href} aria-current={isActive ? 'page' : undefined}>{link.label}</a>;
    })}
  </nav>
  <div class="header-actions">
    <button class="language-button" id="language-toggle" aria-label="切换语言" title="切换语言">EN</button>
    <button class="icon-button" id="theme-toggle" type="button" aria-label="切换深色模式" title="切换深色模式" aria-pressed="false">◐</button>
    <a
      class="icon-button github-link"
      href="https://github.com/boyang167"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="GitHub：boyang167"
      title="GitHub · boyang167"
    >
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path
          fill="currentColor"
          d="M12 0C5.37 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.565 22.092 24 17.592 24 12c0-6.627-5.373-12-12-12z"
        />
      </svg>
    </a>
    <div class="header-cta" aria-label="联系与社交">
      <a class="contact-pill" href="/about/#contact">联系我 <span aria-hidden="true">↗</span></a>
    </div>
    <button class="menu-toggle" id="menu-toggle" aria-label="打开导航" aria-controls="primary-navigation" aria-expanded="false">☰</button>
  </div>
</header>
<script>
  const languageButton = document.querySelector('#language-toggle');
  const themeButton = document.querySelector('#theme-toggle');
  const menuButton = document.querySelector('#menu-toggle');
  const syncThemeButton = (lang = document.documentElement.lang) => {
    const dark = document.documentElement.classList.contains('dark');
    const english = lang === 'en';
    const action = english
      ? (dark ? 'Switch to light mode' : 'Switch to dark mode')
      : (dark ? '切换浅色模式' : '切换深色模式');
    themeButton?.setAttribute('aria-pressed', String(dark));
    themeButton?.setAttribute('aria-label', action);
    themeButton?.setAttribute('title', action);
  };
  themeButton?.addEventListener('click', () => {
    const dark = document.documentElement.classList.toggle('dark');
    localStorage.setItem('theme', dark ? 'dark' : 'light');
    syncThemeButton();
    window.dispatchEvent(new CustomEvent('theme-change', { detail: dark ? 'dark' : 'light' }));
  });
  syncThemeButton();
  const setLanguageLabel = () => {
    const english = document.documentElement.lang === 'en';
    if (languageButton) languageButton.textContent = english ? 'ZH' : 'EN';
    if (languageButton) languageButton.setAttribute('aria-label', english ? 'Switch to Chinese' : '切换到英文');
    if (languageButton) languageButton.setAttribute('title', english ? 'Switch to Chinese' : '切换到英文');
  };
  languageButton?.addEventListener('click', () => {
    const next = document.documentElement.lang === 'en' ? 'zh' : 'en';
    window.dispatchEvent(new CustomEvent('language-change', { detail: next }));
    setLanguageLabel();
    setMenuState(header?.classList.contains('menu-open') ?? false);
  });
  window.addEventListener('language-change', (event) => syncThemeButton(event.detail));
  setLanguageLabel();
  const header = document.querySelector('.site-header');
  const setMenuState = (isOpen: boolean) => {
    header?.classList.toggle('menu-open', isOpen);
    menuButton?.setAttribute('aria-expanded', String(isOpen));
    const english = document.documentElement.lang === 'en';
    menuButton?.setAttribute('aria-label', english ? (isOpen ? 'Close navigation' : 'Open navigation') : (isOpen ? '关闭导航' : '打开导航'));
  };
  const closeMenu = () => setMenuState(false);
  setMenuState(false);
  menuButton?.addEventListener('click', () => {
    setMenuState(!header?.classList.contains('menu-open'));
  });
  header?.querySelectorAll('nav a').forEach((link) => link.addEventListener('click', closeMenu));
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') closeMenu();
  });
</script>
<style>
  .language-button {
    flex: 0 0 auto;
    min-width: 44px;
    height: 44px;
    min-height: 44px;
    padding: 0 10px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    line-height: 1;
    color: var(--blue-strong);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow-sm);
    font-size: 11px;
    font-weight: 800;
    cursor: pointer;
    transition: color .16s ease, background-color .16s ease, border-color .16s ease;
  }
  .language-button:hover {
    color: var(--blue-strong);
    background: var(--blue-soft);
    border-color: color-mix(in srgb, var(--blue) 24%, var(--line));
  }
</style>
