---
import "../styles/global.css";

const {
  title = "Boyang Wang — Tech Notes",
  description = "AI, Data, Agent, Architecture and Bioprocess.",
  language = "en",
} = Astro.props;
const currentPath = Astro.url.pathname;
const navigation = [
  ["/", "Home"],
  ["/blog", "Blog"],
  ["/notes", "Knowledge"],
  ["/search", "Search"],
  ["/projects", "Projects"],
  ["/about", "About"],
];
const isCurrent = (href: string) =>
  currentPath === href ||
  (href !== "/" && currentPath.startsWith(`${href}/`));
---

<!doctype html>
<html lang={language}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <nav class="container nav">
        <a class="brand" href="/">BOYANG WANG</a>
        <div class="nav-links">
          {
            navigation.map(([href, label]) => (
              <a href={href} aria-current={isCurrent(href) ? "page" : undefined}>
                {label}
              </a>
            ))
          }
        </div>
      </nav>
    </header>
    <slot />
    <footer class="site-footer">
      <div class="container">
        © {new Date().getFullYear()} Boyang Wang · AI / Data / Agent /
        Architecture / Bioprocess
      </div>
    </footer>
  </body>
</html>