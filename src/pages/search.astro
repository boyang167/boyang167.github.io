---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Search · Boyang Wang">
  <main class="container search-page">
    <header class="page-head">
      <div class="eyebrow">Knowledge retrieval</div>
      <h1>Search</h1>
      <p class="muted">
        Search titles, tags and full article text across the knowledge base.
      </p>
    </header>

    <form id="search-form" role="search">
      <label class="sr-only" for="search">Search the knowledge base</label>
      <input
        id="search"
        class="search-box"
        type="search"
        name="q"
        placeholder="Search AI Agent, RAG, MCP..."
        autocomplete="off"
        autofocus
      />
    </form>
    <p id="search-status" class="muted" aria-live="polite">
      Start typing to search.
    </p>
    <section
      id="results"
      class="search-results"
      aria-label="Search results"
    >
    </section>
  </main>

  <script>
    interface PagefindResultData {
      url: string;
      excerpt?: string;
      meta?: Record<string, string>;
    }

    interface PagefindResult {
      data(): Promise<PagefindResultData>;
    }

    interface PagefindModule {
      search(query: string): Promise<{ results: PagefindResult[] }>;
    }

    const form = document.querySelector("#search-form");
    const field = document.querySelector("#search");
    const status = document.querySelector("#search-status");
    const results = document.querySelector("#results");
    let pagefindPromise: Promise<PagefindModule> | undefined;
    let searchSequence = 0;
    let debounceTimer: number | undefined;

    const plainText = (html: string) => {
      const container = document.createElement("div");
      container.innerHTML = html;
      return container.textContent || "";
    };

    const loadPagefind = () => {
      if (!pagefindPromise) {
        const pagefindPath = "/pagefind/pagefind.js";
        pagefindPromise = import(
          /* @vite-ignore */ pagefindPath
        ) as Promise<PagefindModule>;
      }
      return pagefindPromise;
    };

    const resultCard = (data: PagefindResultData) => {
      const link = document.createElement("a");
      link.className = "search-result";
      link.href = data.url;

      const meta = document.createElement("div");
      meta.className = "meta";
      meta.textContent = [data.meta?.area, data.meta?.language]
        .filter(Boolean)
        .join(" · ");

      const title = document.createElement("h2");
      title.textContent = data.meta?.title || data.url;

      const excerpt = document.createElement("p");
      excerpt.className = "muted";
      excerpt.textContent = plainText(data.excerpt || "");

      link.append(meta, title, excerpt);
      return link;
    };

    const search = async () => {
      if (
        !(field instanceof HTMLInputElement) ||
        !(status instanceof HTMLElement) ||
        !(results instanceof HTMLElement)
      ) {
        return;
      }
      const query = field.value.trim();
      const sequence = ++searchSequence;
      results.replaceChildren();
      if (!query) {
        status.textContent = "Start typing to search.";
        return;
      }

      status.textContent = "Searching…";
      try {
        const pagefind = await loadPagefind();
        const response = await pagefind.search(query);
        const data = await Promise.all(
          response.results
            .slice(0, 20)
            .map((result: PagefindResult) => result.data()),
        );
        if (sequence !== searchSequence) return;
        results.replaceChildren(...data.map(resultCard));
        status.textContent = data.length
          ? `${response.results.length} result${response.results.length === 1 ? "" : "s"} found.`
          : "No results found.";
      } catch {
        status.textContent =
          "The search index is available in the production build.";
      }
    };

    if (form instanceof HTMLFormElement && field instanceof HTMLInputElement) {
      form.addEventListener("submit", (event) => {
        event.preventDefault();
        search();
      });
      field.addEventListener("input", () => {
        window.clearTimeout(debounceTimer);
        debounceTimer = window.setTimeout(search, 150);
      });
      const initialQuery = new URLSearchParams(window.location.search).get("q");
      if (initialQuery) {
        field.value = initialQuery;
        search();
      }
    }
  </script>
</BaseLayout>