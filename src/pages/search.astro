---
import BaseLayout from "../layouts/BaseLayout.astro";import {getCollection} from "astro:content";const entries=[...await getCollection("blog",({data})=>!data.draft),...await getCollection("notes",({data})=>!data.draft)].map(e=>({title:e.data.title,description:e.data.description,tags:e.data.tags,type:e.collection,href:e.collection==="notes"?`/notes/${e.id}`:`/blog/${e.id}`}));
---
<BaseLayout title="Search · Boyang Wang"><main class="container"><header class="page-head"><div class="eyebrow">Knowledge retrieval</div><h1>Search</h1><p class="muted">Search across articles and technical notes.</p></header><input id="search" class="search-box" placeholder="Search AI Agent, RAG, MCP..." autofocus/><section id="results" class="post-list" style="margin-top:22px"></section></main><script define:vars={{entries}}>const f=document.querySelector("#search"),r=document.querySelector("#results");const show=()=>{const q=f.value.toLowerCase();const x=entries.filter(e=>!q||(e.title+" "+e.description+" "+e.tags.join(" ")).toLowerCase().includes(q));r.innerHTML=x.map(e=>`<a class="post-row" href="${e.href}"><div class="meta">${e.type}</div><div><h2>${e.title}</h2><p class="muted">${e.description}</p></div></a>`).join("")||"<p class='muted'>No results.</p>"};f.addEventListener("input",show);show();</script></BaseLayout>