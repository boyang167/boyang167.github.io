---
import BaseLayout from '../../layouts/BaseLayout.astro';
import MermaidInit from '../../components/MermaidInit.astro';
import ArticleTocAside from '../../components/ArticleTocAside.astro';
import { loadPublishEntries } from '../../lib/knowledge-publish';
import { renderMarkdownDocument } from '../../lib/render-markdown';
import 'katex/dist/katex.min.css';

export function getStaticPaths() {
  return loadPublishEntries().map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { html, toc } = renderMarkdownDocument(entry.body);
const categoryLabel = entry.category.replace(/-/g, ' ');
---
<BaseLayout title={`${entry.title} · 知识库`} description={entry.summary || entry.title}>
  <article
    class="wrap detail-page"
    data-page-title-zh={`${entry.title} · 知识库`}
    data-page-title-en={`${entry.title} · Knowledge base`}
  >
    <header class="detail-hero">
      <a
        class="back-link"
        href="/knowledge/"
        data-page-zh="← 返回知识库"
        data-page-en="← Back to knowledge base"
      >← 返回知识库</a>
      <div class="hero-banner" aria-hidden="true"><span>KB</span></div>
      <div><span class="tag">{categoryLabel}</span></div>
      <h1>{entry.title}</h1>
      {entry.summary && <p class="hero-summary">{entry.summary}</p>}
      <p class="hero-meta"><span data-page-zh="发布于 Wiki" data-page-en="Published wiki">发布于 Wiki</span>{entry.updated && <><span>·</span><span>{entry.updated}</span></>}</p>
    </header>
    <div class:list={['detail-layout', { 'detail-layout--no-toc': toc.length === 0 }]}>
      {toc.length > 0 && (
        <ArticleTocAside
          items={toc}
          ariaLabel="本文目录"
          ariaZh="本文目录"
          ariaEn="On this page"
          titleBilingual
        />
      )}
      <main class="detail-main">
        <div class="prose" set:html={html} />
        <footer class="detail-cta">
          <p>
            <strong data-page-zh="继续探索" data-page-en="Keep exploring">继续探索</strong>
            <span data-page-zh="返回知识库浏览更多已发布主题。" data-page-en="Browse more published topics in the knowledge base.">返回知识库浏览更多已发布主题。</span>
          </p>
          <a href="/knowledge/" data-page-zh="返回知识库" data-page-en="Back to knowledge base">返回知识库</a>
        </footer>
      </main>
    </div>
  </article>
  <MermaidInit />
</BaseLayout>
<script>
  const localizedText = [...document.querySelectorAll<HTMLElement>('[data-page-zh][data-page-en]')];
  const localizedAria = [...document.querySelectorAll<HTMLElement>('[data-page-aria-zh][data-page-aria-en]')];
  const pageRoot = document.querySelector<HTMLElement>('[data-page-title-zh][data-page-title-en]');
  const syncPageLanguage = (lang: string) => {
    localizedText.forEach((element) => {
      element.textContent = lang === 'en' ? element.dataset.pageEn ?? '' : element.dataset.pageZh ?? '';
    });
    localizedAria.forEach((element) => {
      const label = lang === 'en' ? element.dataset.pageAriaEn : element.dataset.pageAriaZh;
      if (label) element.setAttribute('aria-label', label);
    });
    const title = lang === 'en' ? pageRoot?.dataset.pageTitleEn : pageRoot?.dataset.pageTitleZh;
    if (title) document.title = title;
  };
  syncPageLanguage(document.documentElement.lang);
  window.addEventListener('language-change', (event) => {
    syncPageLanguage((event as CustomEvent<string>).detail);
  });

  const tocLinks = [...document.querySelectorAll<HTMLAnchorElement>('.toc-link')];
  if (tocLinks.length > 0) {
    const linkById = new Map(tocLinks.map((link) => [decodeURIComponent(link.hash.slice(1)), link]));
    const expandBranch = (window as Window & { expandTocBranchForLink?: (link: HTMLAnchorElement) => void })
      .expandTocBranchForLink;
    const setActiveToc = (id: string) => {
      tocLinks.forEach((link) => {
        const active = decodeURIComponent(link.hash.slice(1)) === id;
        link.classList.toggle('is-active', active);
        if (active) {
          link.setAttribute('aria-current', 'location');
          expandBranch?.(link);
        } else link.removeAttribute('aria-current');
      });
    };
    const headings = [...document.querySelectorAll<HTMLElement>('.prose h2[id], .prose h3[id], .prose h4[id], .prose h5[id]')]
      .filter((heading) => linkById.has(heading.id));
    if (headings.length > 0) {
      setActiveToc(headings[0].id);
      const syncActiveFromScroll = () => {
        const atPageEnd = window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2;
        const current = atPageEnd ? headings[headings.length - 1] : headings.reduce(
          (active, heading) => heading.getBoundingClientRect().top <= 112 ? heading : active,
          headings[0],
        );
        setActiveToc(current.id);
      };
      const observer = new IntersectionObserver(syncActiveFromScroll, {
        rootMargin: '-96px 0px -65% 0px',
        threshold: [0, 1],
      });
      headings.forEach((heading) => observer.observe(heading));
      window.addEventListener('scroll', syncActiveFromScroll, { passive: true });
      tocLinks.forEach((link) => link.addEventListener('click', () => setActiveToc(decodeURIComponent(link.hash.slice(1)))));
    }
  }
</script>
<style>
  .detail-page{padding:48px 0 80px}
  .detail-hero{max-width:var(--reading-max);margin:0 auto 40px}
  .back-link{display:inline-flex;align-items:center;min-height:40px;color:var(--muted);font-size:12px}
  .back-link:hover{color:var(--blue)}
  .hero-banner{height:132px;margin:10px 0 28px;border:1px solid color-mix(in srgb,var(--blue) 18%,var(--line));border-radius:16px;background:radial-gradient(circle at 78% 22%,color-mix(in srgb,var(--blue) 22%,transparent),transparent 34%),linear-gradient(135deg,var(--surface-raised),var(--blue-soft));display:grid;place-items:center;overflow:hidden}
  .hero-banner span{color:var(--blue);font-size:38px;font-weight:800;letter-spacing:.08em}
  .detail-hero h1{margin:12px 0 14px;font-size:clamp(30px,3.5vw,42px);line-height:1.2;letter-spacing:-.03em}
  .hero-summary{margin:0 0 16px;color:var(--muted);font-size:16px;line-height:1.65}
  .hero-meta{display:flex;flex-wrap:wrap;gap:6px;margin:0;color:var(--muted);font-size:12px}
  .detail-layout{display:grid;grid-template-columns:220px minmax(0,var(--reading-max));gap:64px;justify-content:center;align-items:start}
  .detail-layout--no-toc{grid-template-columns:minmax(0,var(--reading-max))}
  .detail-main{min-width:0}
  .prose{max-width:var(--reading-max);min-width:0;font-size:15px;line-height:1.82}
  .prose :global(h2),.prose :global(h3),.prose :global(h4){scroll-margin-top:96px;color:var(--text);line-height:1.3;letter-spacing:-.02em}
  .prose :global(h2){margin:46px 0 14px;font-size:22px}.prose :global(h3){margin:32px 0 10px;font-size:18px}.prose :global(h4){margin:26px 0 8px;font-size:15px}
  .prose :global(p){margin:0 0 18px}.prose :global(ul),.prose :global(ol){margin:0 0 18px;padding-left:1.3em}.prose :global(li){margin-bottom:6px}
  .prose :global(a){color:var(--blue);font-weight:600;text-decoration:underline;text-underline-offset:3px}
  .prose :global(blockquote){margin:24px 0;padding:4px 0 4px 18px;border-left:3px solid var(--blue);color:var(--muted)}.prose :global(blockquote p){margin:0;color:inherit}
  .prose :global(hr){margin:40px 0;border:0;border-top:1px solid var(--line)}
  .prose :global(pre),.prose :global(.math-display),.prose :global(.mermaid-wrap),.prose :global(table){max-width:100%;overflow-x:auto;overscroll-behavior-inline:contain}
  .prose :global(pre){margin:22px 0;padding:16px;border:1px solid var(--line);border-radius:12px;background:var(--surface-muted);font-size:12px;line-height:1.6}
  .prose :global(:not(pre)>code){padding:2px 6px;border:1px solid var(--line);border-radius:6px;background:var(--surface-raised);font-size:.9em}
  .prose :global(table){display:block;width:100%;margin:22px 0;border-collapse:collapse;font-size:13px;line-height:1.55}
  .prose :global(th),.prose :global(td){min-width:120px;padding:10px 12px;border:1px solid var(--line);text-align:left;vertical-align:top}.prose :global(th){position:sticky;top:0;background:var(--surface-muted)}.prose :global(tr:nth-child(even) td){background:var(--surface-raised)}
  .prose :global(img){display:block;max-width:100%;height:auto;margin:24px auto;border:1px solid var(--line);border-radius:14px}.prose :global(figure){margin:24px 0}.prose :global(figcaption){color:var(--muted);font-size:12px;text-align:center}
  .prose :global(.mermaid-wrap){margin:24px 0;padding:20px 16px;border:1px solid var(--line);border-radius:14px;background:var(--surface-raised)}.prose :global(.mermaid-wrap pre.mermaid){min-width:max-content;margin:0;padding:0;border:0;background:transparent;font-size:0}.prose :global(.mermaid-wrap svg){display:block;max-width:none;height:auto;margin:auto}
  .detail-cta{display:flex;align-items:center;justify-content:space-between;gap:24px;margin-top:48px;padding:24px;border:1px solid var(--line);border-radius:14px;background:var(--surface-raised)}.detail-cta p{display:grid;gap:4px;margin:0;font-size:13px}.detail-cta p span{color:var(--muted)}.detail-cta a{display:inline-flex;align-items:center;min-height:40px;padding:0 12px;border:1px solid var(--line);border-radius:10px;color:var(--blue);font-size:12px;font-weight:700}
  @media(max-width:1160px){.detail-page{padding-top:32px}.detail-layout{grid-template-columns:minmax(0,1fr);gap:28px}}
  @media(max-width:600px){.hero-banner{height:108px}.detail-cta{align-items:flex-start;flex-direction:column}}
</style>
