---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { loadPublishEntries, wikiPublishAvailable } from '../../lib/knowledge-publish';

function formatDisplayDate(value: Date | string): { label: string; iso: string } | null {
  if (typeof value === 'string') {
    const match = value.trim().match(/^(\d{4})[-/.](\d{1,2})[-/.](\d{1,2})(?:\D|$)/);
    if (match) {
      const month = match[2].padStart(2, '0');
      const day = match[3].padStart(2, '0');
      return { label: `${match[1]}.${month}.${day}`, iso: `${match[1]}-${month}-${day}` };
    }
  }
  const date = value instanceof Date ? value : new Date(value);
  if (Number.isNaN(date.getTime())) return null;
  const year = date.getUTCFullYear();
  const month = String(date.getUTCMonth() + 1).padStart(2, '0');
  const day = String(date.getUTCDate()).padStart(2, '0');
  return { label: `${year}.${month}.${day}`, iso: `${year}-${month}-${day}` };
}

const entries = loadPublishEntries().map((entry) => ({
  ...entry,
  displayDate: formatDisplayDate(entry.updated),
}));
const submoduleReady = wikiPublishAvailable();

const categoryIcons: Record<string, string> = {
  'big-data': '⌁',
  biological: '◉',
  database: '▦',
  infrastructure: '▦',
  kg: '◈',
  ml: '◉',
  programming: '✳',
  tech: '⌘',
  general: '✳',
};

function categoryTitle(id: string) {
  const labels: Record<string, string> = {
    'big-data': '数据工程',
    biological: '生信与数据',
    database: '数据库',
    infrastructure: '基础设施',
    kg: '知识图谱',
    ml: '机器学习',
    programming: '编程',
    tech: '技术分享',
    general: '综合',
  };
  return labels[id] ?? id.replace(/-/g, ' ');
}

const byCategory = new Map<string, typeof entries>();
for (const entry of entries) {
  const list = byCategory.get(entry.category) ?? [];
  list.push(entry);
  byCategory.set(entry.category, list);
}
---
<BaseLayout title="技术知识库 · Boyang Wang">
  <section class="wrap page-hero">
    <div class="eyebrow">A MAP OF WHAT I'M LEARNING</div>
    <h1>技术知识库</h1>
    <p
      data-page-zh="将经过整理与审核的技术内容，组织成可持续导航的公开知识地图。"
      data-page-en="Reviewed technical material organized as a durable, navigable knowledge map."
    >
      将经过整理与审核的技术内容，组织成可持续导航的公开知识地图。
    </p>
  </section>
  <section class="wrap knowledge-layout">
    <aside class="knowledge-sidebar card">
      <p class="sidebar-kicker" data-page-zh="按主题浏览" data-page-en="Browse by topic">按主题浏览</p>
      <b>知识目录</b>
      <a class="selected" href="#articles">⌂　总览</a>
      {[...byCategory.keys()].map((cat) => (
        <a href={`#cat-${cat}`}>{categoryIcons[cat] ?? '◈'}　{categoryTitle(cat)}</a>
      ))}
      <div class="sidebar-note">
        <span>✦</span>
        <b>{submoduleReady ? '已关联 wiki' : '未初始化 submodule'}</b>
        <small>
          {submoduleReady
            ? `${entries.length} 篇已发布笔记`
            : '运行 git submodule update --init'}
        </small>
      </div>
    </aside>
    <div class="knowledge-main" id="articles">
      <div class="knowledge-heading">
        <div>
          <h2>已发布笔记</h2>
          <p class="muted">仅展示经审核的 publish 副本，与 Agent 用的 wiki 主库分离。</p>
        </div>
        <span class="tag">公开内容</span>
      </div>
      {entries.length === 0 ? (
        <div class="empty-card">
          <strong data-page-zh="暂无公开内容" data-page-en="No public entries yet">暂无公开内容</strong>
          <p class="muted">
            <span
              data-page-zh="将内容复制到 Wiki 仓库的"
              data-page-en="Copy reviewed content into the Wiki repo’s"
            >将内容复制到 Wiki 仓库的</span>
            <code>publish/</code>
            <span
              data-page-zh="并推送，门户会在重建后显示文章。"
              data-page-en="folder and push; entries appear after the portal rebuilds."
            >并推送，门户会在重建后显示文章。</span>
          </p>
          <a
            class="text-link"
            href="https://github.com/boyang167/personal-knowledge-wiki"
            rel="noopener"
            data-page-zh="前往 Wiki 仓库 ↗"
            data-page-en="Open Wiki repo ↗"
          >前往 Wiki 仓库 ↗</a>
        </div>
      ) : (
        <>
          {[...byCategory.entries()].map(([cat, list]) => (
            <div class="category-block" id={`cat-${cat}`}>
              <h3>{categoryTitle(cat)}</h3>
              <div class="grid-2">
                {list.map((item) => (
                  <a class="card knowledge-card" href={`/knowledge/${item.slug}/`}>
                    <div class="knowledge-card-top">
                      <div class="card-icon">{categoryIcons[cat] ?? '◈'}</div>
                      <span class="knowledge-card-arrow" aria-hidden="true">↗</span>
                    </div>
                    <h3>{item.title}</h3>
                    {item.summary ? (
                      <p class="muted">{item.summary}</p>
                    ) : (
                      <p
                        class="muted"
                        data-page-zh="暂未添加摘要。"
                        data-page-en="No summary yet."
                      >
                        暂未添加摘要。
                      </p>
                    )}
                    <div class="knowledge-bottom">
                      {item.displayDate ? (
                        <time datetime={item.displayDate.iso}>{item.displayDate.label}</time>
                      ) : (
                        <span>{item.tags.slice(0, 2).join(' · ') || 'publish'}</span>
                      )}
                    </div>
                  </a>
                ))}
              </div>
            </div>
          ))}
        </>
      )}
      <div class="knowledge-banner">
        <div class="card-icon">✧</div>
        <div>
          <b>仓库关联</b>
          <p class="muted">Submodule：<code>external/personal-knowledge-wiki</code>。push publish/ 触发门户 Actions 重建。</p>
        </div>
        <a href="https://github.com/boyang167/personal-knowledge-wiki" rel="noopener">Wiki 仓库 ↗</a>
      </div>
    </div>
  </section>
</BaseLayout>
<script>
  const localizedText = [...document.querySelectorAll('[data-page-zh][data-page-en]')];
  const syncPageLanguage = (lang) => {
    localizedText.forEach((element) => {
      const text = lang === 'en' ? element.dataset.pageEn : element.dataset.pageZh;
      if (text) element.textContent = text;
    });
  };
  syncPageLanguage(document.documentElement.lang);
  window.addEventListener('language-change', (event) => syncPageLanguage(event.detail));
</script>
<style>
  .knowledge-layout {
    display: grid;
    grid-template-columns: 220px minmax(0, 1fr);
    gap: 32px;
    align-items: start;
    padding-bottom: 72px;
  }
  .knowledge-sidebar {
    position: sticky;
    top: 96px;
    display: grid;
    height: max-content;
    gap: 6px;
    padding: 16px;
    background: var(--surface-raised);
  }
  .sidebar-kicker {
    margin: 0 8px 10px;
    color: var(--muted);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: .08em;
    text-transform: uppercase;
  }
  .knowledge-sidebar > b { padding: 0 8px 6px; font-size: 11px; }
  .knowledge-sidebar > a {
    display: flex;
    min-height: 40px;
    align-items: center;
    padding: 8px 10px;
    border-radius: 8px;
    color: var(--muted);
    font-size: 11px;
  }
  .knowledge-sidebar > a.selected,
  .knowledge-sidebar > a:hover { color: var(--blue-strong); background: var(--blue-soft); }
  .sidebar-note {
    display: grid;
    gap: 4px;
    margin-top: 20px;
    padding: 14px;
    border-radius: 10px;
    background: var(--surface-muted);
  }
  .sidebar-note span { color: var(--blue); }
  .sidebar-note b { font-size: 11px; }
  .sidebar-note small { color: var(--muted); font-size: 10px; }
  .knowledge-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 24px;
  }
  .knowledge-heading h2 { margin: 0 0 5px; font-size: 22px; }
  .knowledge-heading p { margin: 0; font-size: 11px; }
  .category-block { margin-bottom: 36px; scroll-margin-top: 100px; }
  .category-block > h3 {
    margin: 0 0 14px;
    color: var(--muted);
    font-size: 14px;
    letter-spacing: .06em;
    text-transform: uppercase;
  }
  .knowledge-card {
    display: flex;
    min-width: 0;
    min-height: 196px;
    flex-direction: column;
    padding: 18px;
    transition: transform .2s, border-color .2s, box-shadow .2s;
  }
  .knowledge-card:hover { transform: translateY(-3px); }
  .knowledge-card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 14px;
  }
  .knowledge-card .card-icon {
    width: 36px;
    height: 36px;
    margin: 0;
    border-radius: 10px;
    font-size: 16px;
  }
  .knowledge-card-arrow { color: var(--muted); font-size: 13px; }
  .knowledge-card h3 { margin: 0 0 8px; font-size: 16px; }
  .knowledge-card p {
    display: -webkit-box;
    min-height: 0;
    margin: 0 0 16px;
    overflow: hidden;
    font-size: 12px;
    line-height: 1.6;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
  }
  .knowledge-bottom {
    display: flex;
    justify-content: space-between;
    margin-top: auto;
    padding-top: 12px;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 11px;
  }
  .knowledge-bottom time { font-variant-numeric: tabular-nums; }
  .empty-card {
    padding: 36px 24px;
    border: 1px dashed var(--line);
    border-radius: var(--radius-md);
    text-align: center;
    background: color-mix(in srgb, var(--surface) 62%, transparent);
  }
  .empty-card strong { display: block; margin-bottom: 6px; font-size: 15px; }
  .empty-card p { margin: 0 auto 10px; max-width: 42rem; font-size: 13px; }
  .knowledge-banner {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-top: 20px;
    padding: 18px;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    color: var(--muted);
    background: transparent;
  }
  .knowledge-banner .card-icon { flex-shrink: 0; margin: 0; }
  .knowledge-banner > div:nth-child(2) { flex: 1; }
  .knowledge-banner b { font-size: 12px; }
  .knowledge-banner p { margin: 4px 0 0; font-size: 10px; }
  .knowledge-banner > a {
    display: inline-flex;
    min-height: 40px;
    align-items: center;
    color: var(--blue);
    font-size: 11px;
    font-weight: 700;
    white-space: nowrap;
  }
  @media (max-width: 760px) {
    .knowledge-layout { grid-template-columns: 1fr; }
    .knowledge-sidebar {
      position: static;
      display: flex;
      overflow-x: auto;
      gap: 6px;
      padding: 10px;
      scrollbar-width: thin;
    }
    .sidebar-kicker,
    .knowledge-sidebar > b,
    .sidebar-note { display: none; }
    .knowledge-sidebar > a { flex: 0 0 auto; white-space: nowrap; }
    .knowledge-heading { align-items: flex-start; }
    .knowledge-banner { align-items: flex-start; flex-wrap: wrap; }
    .knowledge-banner > a { margin-left: 0; }
  }
</style>
