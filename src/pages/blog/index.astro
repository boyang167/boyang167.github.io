---
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  BLOG_LIST_PAGE_SIZE,
  collectBlogCategories,
  formatBlogDate,
  formatBlogDateDots,
  getPublishedBlogPosts,
  blogPostHref,
  groupBlogPostsByYear,
} from '../../lib/blog';

const posts = await getPublishedBlogPosts();
const filterCategories = collectBlogCategories(posts);
const BLOG_CATEGORY_LABELS: Record<string, string> = {
  'AI Agent': 'AI Agent',
  '数据工程': 'Data engineering',
  '机器学习': 'Machine learning',
  '知识管理': 'Knowledge management',
  '产品与方案': 'Products and solutions',
  '个人开源产品': 'Personal open-source products',
};
const postCount = posts.length;
const yearGroups = groupBlogPostsByYear(posts);
const showYearGroups = postCount >= 6;
let order = 0;
---
<BaseLayout title="技术博客 · Boyang Wang">
  <section class="wrap page-hero blog-hero">
    <div class="eyebrow">NOTES FROM BUILDING</div>
    <h1>技术博客</h1>
    <p
      class="blog-lead"
      data-page-zh="记录工程实践、Agent 工作流与持续学习中的关键判断。"
      data-page-en="Notes on engineering practice, Agent workflows, and the decisions behind continuous learning."
    >
      记录工程实践、Agent 工作流与持续学习中的关键判断。
    </p>
    <p class="blog-stat muted">
      <span id="blog-stat-total">{postCount}</span>
      <span data-page-zh="篇已发布" data-page-en="published">篇已发布</span>
      <span class="blog-stat-sep" id="blog-stat-sep" hidden> · </span>
      <span id="blog-stat-range" hidden></span>
    </p>
  </section>

  <section
    class="wrap blog-toolbar"
    aria-label="筛选与搜索"
    data-page-aria-zh="筛选与搜索"
    data-page-aria-en="Filters and search"
  >
    <div class="blog-toolbar-panel">
      <div
        class="filter-row"
        role="group"
        aria-label="按分类筛选"
        data-page-aria-zh="按分类筛选"
        data-page-aria-en="Filter by category"
      >
        <button
          type="button"
          class="filter active"
          data-filter="全部"
          data-page-zh="全部"
          data-page-en="All"
          aria-pressed="true"
        >
          全部
        </button>
        {filterCategories.map((cat) => (
          <button
            type="button"
            class="filter"
            data-filter={cat}
            data-page-zh={cat}
            data-page-en={BLOG_CATEGORY_LABELS[cat] ?? cat}
            aria-pressed="false"
          >
            {cat}
          </button>
        ))}
      </div>
      <label class="blog-search">
        <span class="blog-search-icon" aria-hidden="true">⌕</span>
        <input id="search" type="search" placeholder="搜索文章…" aria-label="搜索文章" autocomplete="off" />
      </label>
    </div>
  </section>

  <section class="wrap blog-list-section">
    <div class="blog-feed" id="blog-feed" data-page-size={BLOG_LIST_PAGE_SIZE} data-total={postCount}>
      {yearGroups.map(({ year, posts: yearPosts }) => (
        <section class="blog-year-block" data-year={year}>
          {showYearGroups && (
            <h2 class="blog-year-heading">
              <span>{year}</span>
            </h2>
          )}
          <div class="blog-grid">
            {yearPosts.map((post) => {
              const i = order++;
              return (
                <a
                  class="card blog-card blog-item"
                  href={blogPostHref(post)}
                  data-category={post.data.category}
                  data-title={post.data.title.toLowerCase()}
                  data-description={post.data.description.toLowerCase()}
                  data-year={year}
                  data-order={i}
                >
                  <div class="blog-card-head">
                    <span class="blog-card-icon" aria-hidden="true">{post.data.icon}</span>
                    <span class="tag">{post.data.category}</span>
                  </div>
                  <h3 class="blog-card-title">{post.data.title}</h3>
                  <p class="blog-card-desc muted">{post.data.description}</p>
                  <div class="blog-card-foot">
                    <time datetime={formatBlogDate(post.data.date)}>{formatBlogDateDots(post.data.date)}</time>
                    <span>阅读 {post.data.readTime} ↗</span>
                  </div>
                </a>
              );
            })}
          </div>
        </section>
      ))}
    </div>
    <div class="empty-state" id="empty-state" hidden>
      <strong data-page-zh="没有匹配的文章" data-page-en="No matching posts">没有匹配的文章</strong>
      <p
        data-page-zh="换一个关键词，或选择“全部”分类继续浏览。"
        data-page-en="Try another keyword or choose “All” to keep browsing."
      >
        换一个关键词，或选择“全部”分类继续浏览。
      </p>
    </div>
    <div class="blog-list-footer" id="blog-list-footer" hidden={postCount <= BLOG_LIST_PAGE_SIZE}>
      <button type="button" class="button-secondary blog-load-more" id="blog-load-more">
        加载更多
      </button>
    </div>
  </section>
</BaseLayout>

<script define:vars={{ pageSize: BLOG_LIST_PAGE_SIZE }}>
  const feed = document.querySelector('#blog-feed');
  const filters = [...document.querySelectorAll('[data-filter]')];
  const search = document.querySelector('#search');
  const rows = [...document.querySelectorAll('.blog-item')];
  const yearBlocks = [...document.querySelectorAll('.blog-year-block')];
  const empty = document.querySelector('#empty-state');
  const footer = document.querySelector('#blog-list-footer');
  const loadMore = document.querySelector('#blog-load-more');
  const statSep = document.querySelector('#blog-stat-sep');
  const statRange = document.querySelector('#blog-stat-range');
  const localizedText = [...document.querySelectorAll('[data-page-zh][data-page-en]')];
  const localizedAria = [...document.querySelectorAll('[data-page-aria-zh][data-page-aria-en]')];

  function syncPageLanguage(lang) {
    localizedText.forEach((element) => {
      const text = lang === 'en' ? element.dataset.pageEn : element.dataset.pageZh;
      if (text) element.textContent = text;
    });
    localizedAria.forEach((element) => {
      const label = lang === 'en' ? element.dataset.pageAriaEn : element.dataset.pageAriaZh;
      if (label) element.setAttribute('aria-label', label);
    });
  }

  const PAGE_SIZE = Number(feed?.dataset.pageSize || pageSize) || 10;
  let active = '全部';
  let pagesShown = 1;

  function setActiveFilter(btn) {
    active = btn.dataset.filter || '全部';
    filters.forEach((f) => {
      const on = f === btn;
      f.classList.toggle('active', on);
      f.setAttribute('aria-pressed', on ? 'true' : 'false');
    });
  }

  function matchingRows() {
    const q = (search?.value || '').toLowerCase().trim();
    return rows
      .filter((row) => {
        const okCategory = active === '全部' || row.dataset.category === active;
        const haystack = [
          row.dataset.title,
          row.dataset.description,
          row.querySelector('.blog-card-title')?.textContent,
          row.querySelector('.blog-card-desc')?.textContent,
        ].filter(Boolean).join(' ').toLowerCase();
        const okQuery = !q || haystack.includes(q);
        return okCategory && okQuery;
      })
      .sort((a, b) => Number(a.dataset.order) - Number(b.dataset.order));
  }

  function syncYearBlocks() {
    const q = (search?.value || '').trim();
    const showYearHeadings = active === '全部' && !q;
    yearBlocks.forEach((block) => {
      const items = [...block.querySelectorAll('.blog-item')];
      const visibleCount = items.filter((i) => !i.hidden).length;
      block.hidden = visibleCount === 0;
      const heading = block.querySelector('.blog-year-heading');
      if (heading) heading.hidden = !showYearHeadings;
    });
  }

  function applyListState() {
    const matched = matchingRows();
    const limit = pagesShown * PAGE_SIZE;
    let shown = 0;

    rows.forEach((row) => {
      row.hidden = true;
    });

    matched.forEach((row, index) => {
      const show = index < limit;
      row.hidden = !show;
      if (show) shown++;
    });

    const totalMatched = matched.length;
    const hasMore = totalMatched > limit;

    if (feed) feed.hidden = totalMatched === 0;
    if (empty) empty.hidden = totalMatched !== 0;
    if (footer) footer.hidden = totalMatched <= PAGE_SIZE;
    if (loadMore) {
      loadMore.hidden = !hasMore;
      const rest = totalMatched - limit;
      const english = document.documentElement.lang === 'en';
      loadMore.textContent = english
        ? (rest > 0 ? `Load more (${rest} remaining)` : 'Load more')
        : (rest > 0 ? `加载更多（还有 ${rest} 篇）` : '加载更多');
    }

    syncYearBlocks();

    if (statRange && statSep) {
      if (totalMatched === 0) {
        statSep.hidden = true;
        statRange.hidden = true;
        statRange.textContent = '';
      } else if (totalMatched > PAGE_SIZE || active !== '全部' || (search?.value || '').trim()) {
        statSep.hidden = false;
        statRange.hidden = false;
        statRange.textContent = document.documentElement.lang === 'en'
          ? `Showing ${shown} / ${totalMatched}`
          : `当前显示 ${shown} / ${totalMatched} 篇`;
      } else {
        statSep.hidden = true;
        statRange.hidden = true;
        statRange.textContent = '';
      }
    }
  }

  function resetAndApply() {
    pagesShown = 1;
    applyListState();
  }

  filters.forEach((btn) =>
    btn.addEventListener('click', () => {
      setActiveFilter(btn);
      resetAndApply();
    }),
  );
  search?.addEventListener('input', resetAndApply);
  loadMore?.addEventListener('click', () => {
    pagesShown += 1;
    applyListState();
  });

  syncPageLanguage(document.documentElement.lang);
  window.addEventListener('language-change', (event) => {
    syncPageLanguage(event.detail);
    queueMicrotask(resetAndApply);
  });
  resetAndApply();
</script>

<style>
  .blog-hero {
    padding-bottom: 36px;
  }
  .blog-hero h1 {
    margin-bottom: 12px;
  }
  .blog-lead {
    max-width: 680px;
    margin-bottom: 14px;
  }
  .blog-stat {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.01em;
    margin: 0;
  }
  .blog-stat-sep {
    opacity: 0.5;
  }
  #blog-stat-range {
    font-weight: 500;
  }

  .blog-toolbar {
    margin-bottom: 32px;
  }
  .blog-toolbar-panel {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    flex-wrap: wrap;
    padding: 12px;
    border-radius: var(--radius-md);
    background: var(--surface-raised);
    border: 1px solid var(--line);
    box-shadow: var(--shadow-md);
  }
  .filter-row {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
    flex: 1 1 auto;
    min-width: 0;
  }
  .filter {
    min-height: 40px;
    border: 1px solid transparent;
    background: transparent;
    border-radius: 100px;
    padding: 8px 14px;
    color: var(--muted);
    font-size: 12px;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.18s ease, color 0.18s ease, box-shadow 0.18s ease;
  }
  .filter:hover {
    color: var(--text);
    background: var(--surface-muted);
  }
  .filter.active {
    background: var(--blue-soft);
    border-color: color-mix(in srgb, var(--blue) 14%, transparent);
    color: var(--blue-strong);
    box-shadow: none;
  }
  .filter:focus-visible {
    outline: 3px solid color-mix(in srgb, var(--blue) 55%, transparent);
    outline-offset: 2px;
  }

  .blog-search {
    display: flex;
    align-items: center;
    gap: 8px;
    flex: 0 1 240px;
    min-width: 160px;
    padding: 0 12px;
    min-height: 44px;
    border-radius: 11px;
    background: var(--surface);
    border: 1px solid var(--line);
  }
  .blog-search-icon {
    color: var(--muted);
    font-size: 14px;
    line-height: 1;
    user-select: none;
  }
  .blog-search input {
    border: none;
    background: transparent;
    color: var(--text);
    font: inherit;
    font-size: 13px;
    width: 100%;
    min-width: 0;
    min-height: 42px;
    padding: 8px 0;
    outline: none;
  }
  .blog-search input::placeholder {
    color: color-mix(in srgb, var(--muted) 88%, transparent);
  }
  .blog-search:focus-within {
    border-color: var(--blue);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--blue) 16%, transparent);
  }

  .blog-list-section {
    padding-bottom: 72px;
  }
  .blog-feed {
    display: flex;
    flex-direction: column;
    gap: 36px;
  }
  .blog-year-block {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .blog-year-heading {
    margin: 0;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--muted);
  }
  .blog-year-heading span {
    font-variant-numeric: tabular-nums;
  }
  .blog-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
  }
  .blog-card {
    display: flex;
    flex-direction: column;
    padding: 20px;
    min-height: 100%;
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease,
      border-color 0.2s ease;
  }
  .blog-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 14px 36px rgba(24, 36, 59, 0.08);
    border-color: color-mix(in srgb, var(--blue) 22%, var(--line));
  }
  .blog-card:focus-visible {
    outline: 3px solid color-mix(in srgb, var(--blue) 55%, transparent);
    outline-offset: 3px;
    box-shadow:
      var(--shadow-sm),
      0 0 0 3px color-mix(in srgb, var(--blue) 40%, transparent);
  }
  .blog-card-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    margin-bottom: 14px;
  }
  .blog-card-icon {
    width: 36px;
    height: 36px;
    display: grid;
    place-items: center;
    border-radius: 10px;
    background: var(--blue-soft);
    color: var(--blue);
    font-size: 16px;
    flex-shrink: 0;
  }
  .blog-card-head .tag {
    max-width: 55%;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .blog-card-title {
    margin: 0 0 8px;
    font-size: 17px;
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.35;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .blog-card-desc {
    margin: 0 0 16px;
    font-size: 13px;
    line-height: 1.65;
    flex: 1 1 auto;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .blog-card-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    margin-top: auto;
    padding-top: 14px;
    border-top: 1px solid var(--line);
    font-size: 11px;
    font-weight: 600;
    color: var(--muted);
  }
  .blog-card-foot time {
    font-variant-numeric: tabular-nums;
  }
  .blog-card-foot span:last-child {
    color: var(--blue);
    white-space: nowrap;
  }

  .blog-list-footer {
    display: flex;
    justify-content: center;
    padding-top: 24px;
  }
  .blog-load-more {
    min-width: 200px;
  }

  .empty-state {
    text-align: center;
    padding: 42px 20px;
    margin: 0;
    border: 1px dashed var(--line);
    border-radius: var(--radius-md);
    background: color-mix(in srgb, var(--surface) 62%, transparent);
  }
  .empty-state strong {
    display: block;
    margin-bottom: 6px;
    font-size: 15px;
  }
  .empty-state p {
    margin: 0;
    font-size: 13px;
  }
  [hidden] {
    display: none !important;
  }

  @media (max-width: 980px) {
    .blog-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 650px) {
    .blog-toolbar-panel {
      flex-direction: column;
      align-items: stretch;
      padding: 12px;
    }
    .filter-row {
      gap: 4px;
    }
    .filter {
      padding: 7px 12px;
      font-size: 11px;
    }
    .blog-search {
      flex: 1 1 auto;
      width: 100%;
    }
    .blog-card {
      padding: 18px;
    }
    .blog-grid {
      grid-template-columns: 1fr;
      gap: 14px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .blog-card,
    .filter {
      transition: none;
    }
    .blog-card:hover {
      transform: none;
    }
  }

  .dark .blog-card:hover {
    box-shadow: 0 14px 36px rgba(0, 0, 0, 0.18);
  }
</style>
