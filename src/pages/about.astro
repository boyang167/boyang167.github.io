---
import BaseLayout from '../layouts/BaseLayout.astro';

const highlights = [
  { n: '01', title: 'Agent Engineering', desc: 'Architecture · Harness · Runtime · Orchestration' },
  { n: '02', title: 'Data Platform', desc: 'Governance · Knowledge Engineering · AI for BI' },
  { n: '03', title: 'ML / DL', desc: 'Modeling · Validation · Production Lifecycle' },
  { n: '04', title: 'CMC Digitalization', desc: 'Domain Knowledge · Process Intelligence · Delivery' },
];

const principles = [
  {
    n: '01｜',
    title: '业务知识的可计算化',
    lead: '将复杂业务转化为机器可理解的领域模型。',
    desc: '从业务流程、领域术语与数据关系出发，构建统一的领域知识与数据模型，让业务经验转化为可计算、可推理、可复用的数字资产。',
  },
  {
    n: '02｜',
    title: '构建可信赖的 Agent 系统',
    lead: '让 AI 不止于生成答案，更能执行任务、调用工具并交付结果。',
    desc: '通过任务规划与分解、SQL / 知识图谱 / 业务规则等工具协同，实现过程可追踪、结论有依据、结果可验证的人机协同系统。',
  },
  {
    n: '03｜',
    title: '从算法研发到产品交付',
    lead: '打通算法、数据、工程与云原生部署的完整链路。',
    desc: '通过算法平台、数据平台与 DevOps 工程体系，结合 Skill / MCP 扩展机制，将模型与智能体能力沉淀为可复用、可部署、可持续迭代的软件产品。',
  },
];

const skillAreas = [
  {
    n: '01',
    layout: 'agent',
    title: 'Agent Engineering & Harness & Open-Source Ecosystem',
    summary:
      '面向生产环境的智能体架构、运行时编排、上下文工程，以及开源 Agent 生态的持续研究与工程化实践。',
    groups: [
      {
        label: '架构设计与推理范式 · Architecture & Reasoning',
        items:
          'LangChain · LangGraph · Vercel AI SDK · Multi-Agent Architecture · ReAct · Plan-and-Solve',
      },
      {
        label: '运行时与工具编排 · Runtime & Orchestration',
        items:
          'Agent Harness · MCP · Agent Skills · Tool Calling · Workflow Orchestration · State Management · Execution Control',
      },
      {
        label: '检索与上下文工程 · Retrieval & Context Engineering',
        items:
          'RAG · GraphRAG · Memory Management · Context Engineering · Retrieval & Reranking',
      },
      {
        label: '开源 Agent 项目研究 · Open-Source Agent Projects',
        projects: [
          { category: 'Personal Agent', items: 'OpenClaw · Hermes Agent' },
          { category: 'General-Purpose Agent', items: 'DeerFlow' },
          { category: 'Code Agent', items: 'Pi · Codex · Claude Code · Cursor' },
          { category: 'Multi-Agent Collaboration', items: 'Multica · Orca' },
          { category: 'Data Agent', items: 'DB-GPT · Wren' },
          {
            category: 'Agent Development Framework',
            items: 'Vercel AI SDK · LangGraph',
          },
          {
            category: 'Workflow Orchestration',
            items: 'Dify · n8n',
            layout: 'rail',
          },
        ],
      },
    ],
  },
  {
    n: '02',
    title: 'Data Engineering & AI for BI',
    summary: '数据接入、平台治理与面向分析场景的智能问数能力。',
    groups: [
      {
        label: '数据计算与接入',
        items: 'NumPy · Pandas · PySpark · Hive · Flink · CDC',
      },
      {
        label: '平台与数据治理',
        items: 'Atlas · 批流一体 · 数据集成 · 元数据治理 · 语义层',
      },
      {
        label: '智能分析与问数',
        items: 'Data Agent · Text-to-SQL · 自然语言数据分析',
      },
    ],
  },
  {
    n: '03',
    layout: 'ml',
    title: 'Machine Learning & Deep Learning',
    summary: '覆盖经典建模、深度网络、训练框架与模型全生命周期工程。',
    groups: [
      {
        label: '经典机器学习',
        projects: [
          {
            category: '分类',
            items:
              'Naive Bayes · Logistic Regression · SVM · Decision Tree · KNN · MaxEnt',
          },
          {
            category: '回归',
            items: 'Linear Regression · Ridge · Lasso · Tree Regression',
          },
          {
            category: '聚类 · 主题 · 关联',
            items:
              'K-Means · Hierarchical Clustering · LDA · pLSA · EM · Apriori · FP-Growth',
          },
          {
            category: '序列 · 集成',
            items: 'HMM · MEMM · CRF · AdaBoost · GBDT · XGBoost · LightGBM',
          },
          {
            category: '降维',
            items: 'PCA · SVD',
          },
        ],
      },
      {
        label: '深度学习 · NLP',
        projects: [
          {
            category: 'Word Repr.',
            items: 'One-Hot · GloVe · Word2Vec · FastText · TextCNN · ELMo',
          },
          {
            category: 'Transformer',
            items: 'Transformer · Transformer-XL',
          },
          {
            category: 'Autoencoder LM',
            items: 'BERT · ALBERT · RoBERTa · ERNIE · XLNet · BART · T5',
          },
          {
            category: 'Autoregressive LM',
            items: 'GPT-1 · GPT-2 · GPT-3 · InstructGPT',
          },
          { category: 'Sequence', items: 'RNN · LSTM · Attention' },
        ],
      },
      {
        label: '深度学习 · Vision & Gen',
        projects: [
          {
            category: 'Backbone',
            items: 'LeNet · AlexNet · ResNet · ViT · Swin · MobileViT · CapsNet',
          },
          { category: 'Detection', items: 'Faster R-CNN · YOLO' },
          {
            category: 'Classical CV',
            items: 'Morphology · Binary Ops · Hough · Augmentation',
          },
          { category: 'OpenCV', items: 'OpenCV · cv2 Pipeline' },
          { category: 'Generative', items: 'GAN · U-Net · VAE · Flow' },
          { category: 'Protein', items: 'ESM · AlphaFold2' },
        ],
      },
      {
        label: '深度学习 · Graph',
        projects: [
          { category: 'Analytics', items: 'PageRank · HITS' },
          {
            category: 'Embedding',
            items: 'DeepWalk · LINE · node2vec · SDNE · struc2vec · EGES',
          },
          { category: 'Message Passing', items: 'GCN · GAT · GraphSAGE' },
          { category: 'Signed · Directed', items: 'SGCN · SiGAT · SDGNN' },
          {
            category: 'Heterogeneous',
            items: 'HAN · GTN · metapath2vec · GATNE · BiNE',
          },
          {
            category: 'Dynamic',
            items: 'DySAT · EvolveGCN · TGAT · DGNN',
          },
        ],
      },
      {
        label: '深度学习 · RL',
        projects: [
          { category: 'Foundations', items: 'MDP · MRP · POMDP · Bellman' },
          { category: 'Bootstrapping', items: 'MC · TD · DP · n-step TD · TD(λ)' },
          { category: 'Tabular', items: 'Q-Learning · SARSA' },
          {
            category: 'Deep Value',
            items: 'DQN · Double DQN · Prioritized ER',
          },
          {
            category: 'Policy · Actor-Critic',
            items: 'Policy Gradient · Actor-Critic · PPO · DDPG',
          },
        ],
      },
      { label: '训练与推理框架', items: 'PyTorch · TensorFlow · Scikit-learn' },
      {
        label: 'MLOps 与模型工程',
        items:
          'Feature Engineering · Model Evaluation · Cross-Validation · Ensembling · Explainability · Deployment',
      },
    ],
  },
  {
    n: '04',
    title: 'Full-Stack Engineering',
    summary: '支撑独立产品交付的前后端开发、数据访问与工程化质量保障。',
    groups: [
      { label: '前端工程', items: 'React · Vue · TypeScript · HTML · CSS' },
      {
        label: '后端与服务架构',
        items: 'Go · Python · Java · Microservices · Serverless',
      },
      { label: '持久化与缓存', items: 'SQL · PostgreSQL · MySQL · Redis · Kafka · RabbitMQ' },
      {
        label: '集成与交付质量',
        items: 'API Integration · AuthN/AuthZ · Automated Testing · 全栈协同交付',
      },
    ],
  },
  {
    n: '05',
    title: 'Platform Engineering & Cloud Native',
    summary: '企业级平台架构、云原生运维与多云环境落地经验。',
    groups: [
      {
        label: '平台与 API 治理',
        items: 'Microservices · API Design & Governance · Enterprise Platform',
      },
      {
        label: '云原生与 DevOps',
        items: 'Kubernetes · Docker · CI/CD · Automated Release',
      },
      {
        label: '多云基础设施',
        items: 'Microsoft Azure · Alibaba Cloud · Tencent Cloud',
      },
    ],
  },
  {
    n: '06',
    layout: 'ml',
    title: 'Math',
    summary: '概率基础、信息论、随机过程与采样方法。',
    groups: [
      {
        label: '概率与采样',
        projects: [
          { category: 'Monte Carlo', items: 'Monte Carlo Method' },
          { category: 'Markov Chain', items: 'Markov Chain' },
          { category: 'MCMC', items: 'MCMC · Metropolis-Hastings' },
          { category: 'Gibbs', items: 'Gibbs Sampling' },
        ],
      },
      {
        label: '信息论',
        items:
          'Entropy · Conditional Entropy · Mutual Information · Cross-Entropy',
      },
    ],
  },
];

const timeline = [
  {
    date: '2022 – 至今',
    tag: '药明生物 · Manager Data Scientist',
    title: 'CMC 数据底座、Agent 与算法落地',
    desc: '对接分子分析与 PD，主导 Atlas 多云数据平台从 0 到 1；交付 Digital Control Tower（CMC Agent）、ProteinKG 知识层、PlatformSuite DevOps 与 Biosuite 生信 PaaS；落地 CLD 单克隆识别、上游 PD 预测与分子分析结构化入图谱等算法服务。',
  },
  {
    date: '2021.11 – 2022.01',
    tag: '运去哪 · 算法实习生',
    title: '单证 OCR 与文档理解',
    desc: '单证 OCR / PDF 解析与规则抽取；调研 LayoutLMv2、BiLSTM+CRF 等 NER 方案；使用 Git / Docker 参与团队协作。',
  },
  {
    date: '2021.06 – 2021.09',
    tag: '货拉拉 · 算法实习生',
    title: '亿级 POI 父子关系识别',
    desc: '面向约 1.5 亿级 POI 的父子关系任务：CRF++ 名称结构化 + 周边召回与语义匹配，准确率 97.97%、召回率 95.35%。',
  },
  {
    date: '2019 – 2022',
    tag: '上海海事大学 · 硕士',
    title: '计算机科学与技术（NLP 方向）',
    desc: '研究方向：命名实体识别、预训练语言模型。第十七届中国研究生数学建模竞赛全国一等奖。',
  },
  {
    date: '2015 – 2019',
    tag: '吉林师范大学 · 学士',
    title: '信息管理与信息系统',
    desc: 'GPA 3.8；第三届图灵杯 ACM 程序设计比赛全国三等奖（团队赛）。',
  },
];

const splitSkillItems = (items: string) =>
  items
    .split(' · ')
    .map((s) => s.trim())
    .filter(Boolean);
---

<BaseLayout
  title="关于我 · Boyang Wang"
  description="Boyang Wang — 复合型数据科学家，专注 AI 工程化、Agent Engineering、数据平台与生物制药 CMC 领域落地。"
>
  <section class="wrap about-hero" id="top">
    <div class="about-intro">
      <div class="eyebrow">ABOUT ME · MY STORY</div>
      <h1>你好，我是<br /><span>Boyang Wang</span></h1>
      <p class="about-lead">兼具算法研发、AI 工程化与产品交付能力的复合型数据科学家，具备从算法设计与优化、系统架构设计到独立软件产品研发及落地交付的端到端能力。</p>
      <p class="muted">
        具备从 0 到 1 构建算法平台、数据平台与 DevOps 平台的实践经验，打通算法研发、数据治理、知识工程、Agent Engineering 到云原生部署的完整技术链路。在 AI Agent 领域，专注于 Agent Architecture、Harness Engineering、Agent Runtime、Multi-Agent Orchestration、MCP 与 Skills 等核心技术，致力于构建具备任务规划、工具编排、上下文管理、执行控制与可追溯能力的企业级 Agent 系统。
      </p>
      <p class="muted">
        深耕生物制药 CMC 领域，擅长将复杂的工艺与质量业务转化为结构化、可计算、可推理的领域知识，融合 Machine Learning、Deep Learning、Knowledge Graph 与 Agent 技术，推动 AI 从算法模型走向工程化平台与业务产品落地。
      </p>
      <div class="tag-row" aria-label="核心技术方向">
        <span class="tag">Agent Engineering</span>
        <span class="tag">Data Platform</span>
        <span class="tag">Machine Learning</span>
        <span class="tag">CMC Digitalization</span>
      </div>
      <div class="hero-actions">
        <a class="button-primary" href="#contact">与我交流 ↗</a>
        <a class="button-secondary" href="/blog/">阅读博客</a>
      </div>
    </div>
    <div class="about-portrait">
      <div class="portrait-card">
        <div class="portrait-icon" aria-hidden="true">
          <svg viewBox="0 0 48 40" fill="none" xmlns="http://www.w3.org/2000/svg">
            <circle cx="24" cy="8" r="5" stroke="currentColor" stroke-width="2" />
            <circle cx="12" cy="32" r="5" stroke="currentColor" stroke-width="2" />
            <circle cx="36" cy="32" r="5" stroke="currentColor" stroke-width="2" />
            <path d="M24 13v8M24 21l-12 8M24 21l12 8" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
          </svg>
        </div>
        <p class="portrait-title">AI × Data × CMC</p>
        <p class="portrait-subtitle">From Domain Knowledge to Intelligent Systems</p>
        <span class="portrait-badge">Engineering Intelligence</span>
        <p class="portrait-motto">Curious by nature.<br />Engineer by practice.</p>
      </div>
    </div>
  </section>

  <section class="wrap focus-strip" aria-label="核心能力领域">
    {highlights.map((item) => (
      <article class="focus-item">
        <span class="focus-index">{item.n}</span>
        <strong>{item.title}</strong>
        <small>{item.desc}</small>
      </article>
    ))}
  </section>

  <section class="wrap section capabilities-section">
    <div class="capabilities-header">
      <div class="eyebrow">CAPABILITIES</div>
      <h2>技术能力与研究方向</h2>
      <p class="muted capabilities-intro">
        覆盖 Harness Engineer、数据平台、建模方法、全栈实现与云原生交付，侧重可扩展、可审计、可运维的生产级实践。
      </p>
    </div>
    <div class="capability-stack">
      {skillAreas.map((area, index) => (
        <article
          class:list={[
            'capability-card',
            index < 4 ? 'capability-card-primary' : 'capability-card-supporting',
            area.layout === 'agent' && 'capability-card-featured',
            area.layout === 'agent' && 'skill-area-agent',
            area.layout === 'ml' && 'skill-area-ml',
          ]}
        >
          <header class="skill-area-head">
            <div class="skill-area-head-inner">
              <span class="skill-area-badge" aria-hidden="true">{area.badge ?? area.n}</span>
              <div>
                <h3 class="skill-area-title">{area.title}</h3>
                <p class="skill-area-summary">{area.summary}</p>
              </div>
            </div>
          </header>
          <dl class="skill-groups">
            {area.groups.map((group) => (
              <div
                class:list={[
                  'skill-group',
                  area.layout === 'agent' &&
                    !('projects' in group && group.projects) &&
                    'skill-group-section',
                  'projects' in group && group.projects && 'skill-group-projects',
                ]}
              >
                <dt>
                  <span class="skill-group-label">{group.label}</span>
                </dt>
                {'projects' in group && group.projects ? (
                  <dd class="skill-project-list">
                    {group.projects.map((row) => (
                      <div
                        class:list={[
                          'skill-project-row',
                          row.layout === 'rail' && 'skill-project-row-rail',
                        ]}
                      >
                        <span class="skill-project-cat">{row.category}</span>
                        <div class="skill-chips">
                          {splitSkillItems(row.items).map((item) => (
                            <span class="skill-chip">{item}</span>
                          ))}
                        </div>
                      </div>
                    ))}
                  </dd>
                ) : (
                  <dd class="skill-chips-wrap">
                    <div class="skill-chips">
                      {splitSkillItems(group.items ?? '').map((item) => (
                        <span class="skill-chip">{item}</span>
                      ))}
                    </div>
                    {group.note && <p class="skill-group-note">{group.note}</p>}
                  </dd>
                )}
              </div>
            ))}
          </dl>
        </article>
      ))}
    </div>
  </section>

  <section class="wrap section">
    <div class="section-head">
      <div>
        <div class="eyebrow">MY APPROACH</div>
        <h2>我如何将技术转化为价值</h2>
      </div>
      <p class="muted section-note">
        从业务问题出发，以算法与工程为核心，让技术从模型研发走向产品交付，形成可验证、可复用、可持续演进的闭环。
      </p>
    </div>
    <div class="principles-flow" aria-label="从领域知识到产品交付的方法">
      {principles.map((item, index) => (
        <article class="principle-step">
          <span class="principle-index">{item.n}</span>
          <h3>{item.title}</h3>
          <p class="principle-lead">{item.lead}</p>
          <p class="muted">{item.desc}</p>
          {index < principles.length - 1 && <span class="principle-connector" aria-hidden="true">→</span>}
        </article>
      ))}
    </div>
  </section>

  <section class="wrap section">
    <div class="section-head">
      <div>
        <div class="eyebrow">EXPERIENCE</div>
        <h2>经历与教育</h2>
      </div>
      <span class="muted section-note">基于公开履历整理，企业细节已做概括性表述。</span>
    </div>
    <div class="experience-list">
      {timeline.map((item) => (
        <article class="experience-item">
          <div class="experience-meta">
            <time>{item.date}</time>
            <span>{item.tag}</span>
          </div>
          <div class="experience-content">
            <h3>{item.title}</h3>
            <p class="muted">{item.desc}</p>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="wrap about-cta" id="contact">
    <div class="about-cta-copy">
      <div class="eyebrow">OPEN KNOWLEDGE · LET'S CONNECT</div>
      <h2>把实践沉淀为知识，<br />把技术连接到真实问题。</h2>
      <p class="muted">
        持续分享 Agent、数据平台、机器学习与 CMC 数字化实践，也欢迎交流企业级 Agent 与数据智能系统的工程落地。
      </p>
    </div>
    <nav class="about-cta-links" aria-label="内容与联系">
      <a href="/blog/">
        <span>技术博客</span>
        <small>实践、架构与复盘</small>
        <i>↗</i>
      </a>
      <a href="/knowledge/">
        <span>知识库</span>
        <small>结构化领域知识</small>
        <i>↗</i>
      </a>
      <a href="https://github.com/boyang167" target="_blank" rel="noreferrer">
        <span>GitHub</span>
        <small>代码与公开项目</small>
        <i>↗</i>
      </a>
    </nav>
  </section>
</BaseLayout>

<style>
  .about-hero {
    --about-radius-lg: 24px;
    --about-radius-md: 16px;
    --about-border: color-mix(in srgb, var(--line) 88%, transparent);
    --about-accent-soft: color-mix(in srgb, var(--blue-soft) 82%, var(--surface));
    display: grid;
    grid-template-columns: minmax(0, 1.18fr) minmax(320px, 0.82fr);
    align-items: center;
    gap: clamp(42px, 6vw, 78px);
    padding: clamp(48px, 7vh, 72px) 0 38px;
  }
  .about-intro h1 {
    margin: 14px 0 18px;
    font-size: clamp(42px, 5.4vw, 72px);
    line-height: 1.03;
    letter-spacing: -0.055em;
  }
  .about-intro h1 span {
    color: var(--blue);
  }
  .about-lead {
    margin: 0 0 14px;
    font-size: clamp(17px, 1.55vw, 20px);
    font-weight: 700;
    line-height: 1.58;
    max-width: 650px;
  }
  .about-intro .muted {
    font-size: 13px;
    line-height: 1.82;
    max-width: 680px;
  }
  .about-intro .tag-row {
    margin: 22px 0;
    gap: 7px;
  }
  .about-intro .tag {
    background: transparent;
    border-color: color-mix(in srgb, var(--blue) 18%, var(--line));
    color: color-mix(in srgb, var(--blue) 76%, var(--text));
  }
  .about-portrait {
    min-height: 390px;
    border-radius: var(--about-radius-lg);
    background:
      radial-gradient(circle at 50% 32%, rgba(255, 255, 255, 0.88), transparent 31%),
      linear-gradient(155deg, #eef2fc 0%, #dce5f8 54%, #cfdaf2 100%);
    border: 1px solid rgba(255, 255, 255, 0.65);
    box-shadow: 0 24px 60px rgba(44, 72, 141, 0.1);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 36px 28px;
  }
  .portrait-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    width: min(100%, 300px);
  }
  .portrait-icon {
    color: #4a6fd4;
    margin-bottom: 18px;
  }
  .portrait-icon svg {
    width: 52px;
    height: auto;
    display: block;
