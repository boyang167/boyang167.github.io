---
import BaseLayout from '../layouts/BaseLayout.astro';
const principles = [
  { n:'01', title:'从真实问题出发', desc:'先理解业务约束、数据质量与使用者目标，再选择合适的技术方案。' },
  { n:'02', title:'让 AI 进入工程系统', desc:'关注 Agent 的工具使用、上下文管理、工作流、评估与可靠性，而不止是模型调用。' },
  { n:'03', title:'把经验沉淀成资产', desc:'通过文档、可复用组件、自动化流程和开源项目，让一次实践产生长期价值。' },
];
const skills = [
  { icon:'✳', title:'AI Agent', tags:['Agent Architecture','Workflow','MCP','RAG'] },
  { icon:'⌘', title:'数据工程', tags:['Data Platform','ETL / ELT','Metadata','SQL'] },
  { icon:'◉', title:'机器学习', tags:['Tabular ML','Model Evaluation','XGBoost','MLOps'] },
  { icon:'▦', title:'平台架构', tags:['API Design','Cloud Infrastructure','Observability','DevOps'] },
];
---
<BaseLayout title="自我介绍 · Boyang Wang" description="了解 Boyang Wang 的技术方向、工程理念、项目实践与联系方式。">
  <section class="wrap about-hero" id="top"><div class="about-intro"><div class="eyebrow">ABOUT ME · MY STORY</div><h1>你好，我是<br/><span>Boyang Wang</span></h1><p class="about-lead">一名关注 AI 工程、数据系统与机器学习落地的技术实践者。</p><p class="muted">我喜欢把复杂的问题拆解成清晰的系统：从数据如何流动、模型如何验证，到 Agent 如何可靠地调用工具并融入真实工作流。我也在持续记录实践、分享思考，并把知识转化为可复用的工具。</p><div class="tag-row"><span class="tag">AI Agent</span><span class="tag">Data Engineering</span><span class="tag">Machine Learning</span><span class="tag">System Design</span></div><div class="hero-actions"><a class="button-primary" href="#contact">与我交流 ↗</a><a class="button-secondary" href="/projects/">查看项目</a></div></div><div class="about-portrait"><div class="portrait-glow"></div><div class="portrait-initials">BW</div><div class="portrait-label">Curious by nature.<br/>Engineer by practice.</div><span class="sparkle sparkle-a">✳</span><span class="sparkle sparkle-b">✦</span></div></section>
  <section class="wrap stat-strip"><div><strong>AI × Data</strong><span>关注的技术交叉点</span></div><div><strong>Build</strong><span>以工程实践为导向</span></div><div><strong>Learn</strong><span>持续学习与复盘</span></div><div><strong>Share</strong><span>公开沉淀技术经验</span></div></section>
  <section class="wrap section"><div class="section-head"><div><div class="eyebrow">MY APPROACH</div><h2>我如何看待技术</h2></div><p class="muted section-note">技术的价值不只在于新颖，<br/>更在于能否可靠地解决问题。</p></div><div class="grid-3 principles">{principles.map((item)=><article class="card card-pad"><span class="principle-number">{item.n}</span><h3>{item.title}</h3><p class="muted">{item.desc}</p></article>)}</div></section>
  <section class="wrap section"><div class="section-head"><div><div class="eyebrow">TOOLBOX</div><h2>技术能力与研究方向</h2></div></div><div class="grid-2 skills-grid">{skills.map((skill)=><article class="card skill-card"><div class="card-icon">{skill.icon}</div><div><h3>{skill.title}</h3><div class="tag-row">{skill.tags.map((tag)=><span class="skill-tag">{tag}</span>)}</div></div></article>)}</div></section>
  <section class="wrap section"><div class="section-head"><div><div class="eyebrow">EXPERIENCE</div><h2>我的实践路径</h2></div><span class="muted section-note">以下为可编辑的经历结构，请替换为真实履历。</span></div><div class="timeline"><article class="timeline-item"><div class="timeline-date">NOW</div><div class="timeline-dot"></div><div class="timeline-content"><span class="tag">AI Engineering</span><h3>探索 AI Agent 与企业级智能应用</h3><p class="muted">研究 Agent 架构、工具编排、数据问答和可观测性，尝试将 AI 能力转化为可维护的工程系统。</p></div></article><article class="timeline-item"><div class="timeline-date">RECENT</div><div class="timeline-dot"></div><div class="timeline-content"><span class="tag">Data & Platform</span><h3>构建数据平台与工程基础设施</h3><p class="muted">围绕数据集成、平台标准化、API 治理与自动化运维，关注系统稳定性和团队协作效率。</p></div></article><article class="timeline-item"><div class="timeline-date">ONGOING</div><div class="timeline-dot"></div><div class="timeline-content"><span class="tag">Machine Learning</span><h3>把数据建模应用到实际问题</h3><p class="muted">关注数据泄漏防控、交叉验证、独立测试集与模型可解释性，让模型评估更接近真实应用场景。</p></div></article></div></section>
  <section class="wrap section impact-section"><div><div class="eyebrow">OPEN KNOWLEDGE</div><h2>把过程公开，<br/>让影响力持续积累。</h2><p class="muted">我会持续分享项目拆解、技术方案、踩坑记录与学习笔记。希望这些内容不仅是答案，也能帮助其他人更快建立自己的判断框架。</p><a class="button-primary" href="/blog/">阅读技术文章 ↗</a></div><div class="impact-list"><a href="/blog/"><span class="impact-icon">✎</span><span><b>技术文章</b><small>系统化记录学习与工程实践</small></span><span>↗</span></a><a href="/projects/"><span class="impact-icon">⌘</span><span><b>项目作品</b><small>展示思路、架构与实现过程</small></span><span>↗</span></a><a href="/knowledge/"><span class="impact-icon">▤</span><span><b>知识库</b><small>把零散笔记组织成知识体系</small></span><span>↗</span></a></div></section>
  <section class="wrap contact-section" id="contact"><div class="eyebrow">LET'S CONNECT</div><h2>一起交流想法，探索新的可能。</h2><p class="muted">如果你对 AI Agent、数据平台、机器学习工程或知识管理感兴趣，欢迎联系交流。</p><div class="contact-links"><a href="https://github.com/your-github-id" target="_blank" rel="noreferrer">⌘ GitHub <span>↗</span></a><a href="https://www.linkedin.com/in/your-linkedin-id/" target="_blank" rel="noreferrer">in LinkedIn <span>↗</span></a><a href="mailto:your-email@example.com">✉ Email <span>↗</span></a></div><p class="contact-hint">上线前请将以上占位链接替换成你的真实账号。</p></section>
</BaseLayout>
<style>
.about-hero{display:grid;grid-template-columns:1.1fr .9fr;align-items:center;gap:70px;padding:65px 0 35px}.about-intro h1{margin:15px 0 20px}.about-intro h1 span{color:var(--blue)}.about-lead{font-size:19px;font-weight:700;max-width:560px}.about-intro .muted{font-size:13px;max-width:600px}.about-intro .tag-row{margin:23px 0}.about-portrait{height:365px;border-radius:28px;background:linear-gradient(145deg,#e8edff,#cbd8fa 65%,#aebff0);position:relative;overflow:hidden;display:grid;place-items:center}.portrait-glow{width:260px;height:260px;border:1px solid #fff9;border-radius:50%;box-shadow:0 0 0 35px #ffffff20,0 0 0 70px #ffffff14}.portrait-initials{position:absolute;font-size:90px;font-weight:800;letter-spacing:-.12em;color:#344d99;text-shadow:0 12px 40px #344d9920}.portrait-label{position:absolute;bottom:25px;right:25px;background:#ffffffdd;border-radius:12px;padding:11px 15px;color:#30436f;font-size:11px;font-weight:700;line-height:1.5}.sparkle{position:absolute;color:#fff;font-size:25px}.sparkle-a{top:48px;right:60px}.sparkle-b{left:48px;bottom:70px}.stat-strip{display:grid;grid-template-columns:repeat(4,1fr);background:var(--surface);border:1px solid var(--line);border-radius:18px;padding:22px 10px;box-shadow:var(--shadow)}.stat-strip>div{padding:0 20px;border-right:1px solid var(--line);display:grid;gap:4px}.stat-strip>div:last-child{border:0}.stat-strip strong{font-size:17px;letter-spacing:-.03em}.stat-strip span{font-size:11px;color:var(--muted)}.section-note{font-size:12px}.principle-number{display:block;font-size:11px;color:var(--blue);font-weight:800;margin-bottom:28px}.principles h3{font-size:17px}.principles p{font-size:12px;margin-bottom:0}.skills-grid{gap:14px}.skill-card{padding:20px;display:flex;align-items:flex-start;gap:15px}.skill-card .card-icon{flex-shrink:0;margin:0}.skill-card h3{font-size:15px;margin:3px 0 12px}.skill-tag{font-size:10px;border:1px solid var(--line);padding:4px 8px;border-radius:7px;color:var(--muted)}.timeline{max-width:850px}.timeline-item{display:grid;grid-template-columns:95px 20px 1fr;gap:15px;min-height:130px}.timeline-date{font-size:10px;color:var(--muted);font-weight:800;padding-top:5px}.timeline-dot{position:relative;width:10px;height:10px;background:var(--blue);border:3px solid var(--blue-soft);border-radius:50%;margin-top:6px}.timeline-dot:after{content:'';position:absolute;width:1px;top:9px;bottom:-110px;left:1px;background:var(--line)}.timeline-item:last-child .timeline-dot:after{display:none}.timeline-content{padding-bottom:27px}.timeline-content h3{margin:10px 0;font-size:16px}.timeline-content p{font-size:12px;max-width:700px}.impact-section{display:grid;grid-template-columns:1fr 1fr;gap:65px;align-items:center;padding:30px 0}.impact-section h2{margin:12px 0}.impact-section p{font-size:13px;max-width:470px}.impact-section .button-primary{margin-top:8px}.impact-list{display:grid;gap:10px}.impact-list>a{display:flex;align-items:center;gap:14px;padding:17px;border:1px solid var(--line);border-radius:14px;background:var(--surface)}.impact-icon{display:grid;place-items:center;width:40px;height:40px;border-radius:12px;background:var(--blue-soft);color:var(--blue)}.impact-list>a>span:nth-child(2){display:grid;flex:1}.impact-list b{font-size:13px}.impact-list small{font-size:10px;color:var(--muted)}.contact-section{text-align:center;margin-top:55px;padding:46px 24px;background:var(--surface);border:1px solid var(--line);border-radius:24px}.contact-section h2{margin:12px 0}.contact-section>p{font-size:12px}.contact-links{display:flex;justify-content:center;flex-wrap:wrap;gap:10px;margin-top:22px}.contact-links a{display:flex;gap:22px;align-items:center;border:1px solid var(--line);border-radius:10px;padding:10px 14px;font-size:12px;font-weight:700}.contact-links a span{color:var(--blue)}.contact-hint{margin:18px 0 0;color:var(--muted);font-size:10px!important}@media(max-width:760px){.about-hero{grid-template-columns:1fr;gap:28px;padding-top:45px}.about-portrait{height:280px;grid-row:1}.stat-strip{grid-template-columns:repeat(2,1fr);gap:18px}.stat-strip>div:nth-child(2){border:0}.stat-strip>div{padding:0 14px}.section-head{align-items:flex-start;flex-direction:column;gap:8px}.timeline-item{grid-template-columns:60px 14px 1fr;gap:10px}.impact-section{grid-template-columns:1fr;gap:25px}.contact-section{padding:32px 18px}.contact-links{flex-direction:column}.contact-links a{justify-content:space-between}}
</style>
