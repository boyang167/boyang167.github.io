---
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  listSkillCategories,
  loadWikiSkills,
  skillCategoryLabel,
  skillDisplayTitle,
  skillIcon,
  wikiSkillsAvailable,
} from '../../lib/wiki-skills';

const entries = loadWikiSkills();
const categories = listSkillCategories();
const skillsReady = wikiSkillsAvailable();

const catAnchor = (id: string) => `cat-${id.replace(/[^a-zA-Z0-9-]/g, '-')}`;

const byCategory = new Map<string, typeof entries>();
for (const entry of entries) {
  const list = byCategory.get(entry.category) ?? [];
  list.push(entry);
  byCategory.set(entry.category, list);
}

const displayCategories = categories.length > 0 ? categories : [];
const showSidebar = displayCategories.length > 1;

function clipSummary(text: string, max = 120): string {
  const t = text.replace(/\s+/g, ' ').trim();
  if (t.length <= max) return t;
  return `${t.slice(0, max).trim()}…`;
}
---

<BaseLayout
  title="Agent Skill · Boyang Wang"
  description="收藏 Cursor Agent Skill，来源 personal-knowledge-wiki/raw/4-Skill。"
>
  <section class="wrap skills-page">
    <header class="skills-hero">
      <p class="eyebrow">Agent Skills</p>
      <div class="skills-hero-row">
        <div>
          <h1>Skill</h1>
          <p class="skills-lead muted">
            可复用的 Agent 工作流与规范 · 每个目录一份 <code>SKILL.md</code>
          </p>
        </div>
        <div class="skills-meta">
          <span class="skills-count">{entries.length}</span>
          <span class="skills-count-label">个 Skill</span>
          <span class="skills-source muted">{skillsReady ? 'raw/4-Skill' : '未找到目录'}</span>
        </div>
      </div>
    </header>

    <div class:list={['skills-body', { 'skills-body--with-nav': showSidebar }]}>
      {showSidebar && (
        <nav class="skills-nav card" aria-label="Skill 目录">
          <p class="skills-nav-title">目录</p>
          <a class="skills-nav-link is-active" href="#skills-list">总览</a>
          {displayCategories.map((cat) => (
            <a class="skills-nav-link" href={`#${catAnchor(cat)}`}>
              {skillCategoryLabel(cat)}
            </a>
          ))}
        </nav>
      )}

      <div class="skills-main" id="skills-list">
        {entries.length === 0 ? (
          <div class="card skills-empty">
            <p class="muted">
              暂无 Skill。在 wiki 仓库
              <code>raw/4-Skill/&lt;skill-name&gt;/SKILL.md</code> 下添加文件，保存后重新构建站点即可出现在此。
            </p>
          </div>
        ) : (
          displayCategories.map((cat) => {
            const list = byCategory.get(cat) ?? [];
            if (list.length === 0) return null;
            const hideSectionTitle = displayCategories.length === 1 && cat === 'skills';
            return (
              <section class="skills-section" id={catAnchor(cat)}>
                {!hideSectionTitle && (
                  <h2 class="skills-section-title">{skillCategoryLabel(cat)}</h2>
                )}
                <ul class="skills-grid">
                  {list.map((item) => (
                    <li>
                      <a class="skill-card" href={`/skills/${item.slug}/`}>
                        <span class="skill-card-icon" aria-hidden="true">{skillIcon(item.slug)}</span>
                        <div class="skill-card-body">
                          <h3>{skillDisplayTitle(item)}</h3>
                          <p class="muted">
                            {clipSummary(item.summary || item.name) || '—'}
                          </p>
                        </div>
                        <span class="skill-card-go" aria-hidden="true">→</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </section>
            );
          })
        )}

        <footer class="skills-foot muted">
          <span>
            遵循 Cursor Skill 格式：<code>name</code> / <code>description</code> 写在 YAML 头；正文为 Agent 执行说明。
          </span>
          <a class="text-link" href="https://github.com/boyang167/personal-knowledge-wiki" rel="noopener">
            Wiki 仓库 ↗
          </a>
        </footer>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .skills-page {
    padding: 56px 0 72px;
  }

  .skills-hero {
    margin-bottom: 32px;
  }

  .skills-hero .eyebrow {
    margin-bottom: 8px;
  }

  .skills-hero h1 {
    font-size: clamp(32px, 3.5vw, 44px);
    margin: 0;
    letter-spacing: -0.03em;
  }

  .skills-hero-row {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    flex-wrap: wrap;
  }

  .skills-lead {
    margin: 8px 0 0;
    font-size: 14px;
    max-width: 36rem;
    line-height: 1.6;
  }

  .skills-lead code {
    font-size: 0.92em;
  }

  .skills-meta {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 2px;
    padding: 12px 16px;
    border-radius: 12px;
    background: var(--surface);
    border: 1px solid var(--line);
    min-width: 7rem;
  }

  .skills-count {
    font-size: 28px;
    font-weight: 800;
    line-height: 1;
    color: var(--blue);
    letter-spacing: -0.04em;
  }

  .skills-count-label {
    font-size: 11px;
    color: var(--muted);
  }

  .skills-source {
    font-size: 10px;
    margin-top: 4px;
    font-family: ui-monospace, monospace;
  }

  .skills-body {
    display: block;
  }

  .skills-body--with-nav {
    display: grid;
    grid-template-columns: 168px minmax(0, 1fr);
    gap: 28px;
    align-items: start;
  }

  .skills-nav {
    position: sticky;
    top: 96px;
    padding: 14px;
    display: grid;
    gap: 4px;
    height: max-content;
  }

  .skills-nav-title {
    margin: 0 0 8px;
    padding: 0 8px;
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted);
  }

  .skills-nav-link {
    padding: 8px 10px;
    border-radius: 8px;
    font-size: 12px;
    color: var(--muted);
    transition: background 0.15s, color 0.15s;
  }

  .skills-nav-link:hover,
  .skills-nav-link.is-active {
    background: var(--blue-soft);
    color: var(--blue);
  }

  .skills-section {
    margin-bottom: 8px;
  }

  .skills-section-title {
    margin: 0 0 14px;
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--muted);
  }

  .skills-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 14px;
  }

  .skill-card {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: start;
    gap: 14px;
    padding: 16px 18px;
    border-radius: 14px;
    background: var(--surface);
    border: 1px solid var(--line);
    box-shadow: 0 1px 0 rgba(34, 55, 100, 0.04);
    transition: border-color 0.2s, box-shadow 0.2s, transform 0.2s;
    min-height: 100%;
  }

  .skill-card:hover {
    border-color: rgba(55, 103, 237, 0.35);
    box-shadow: 0 8px 28px rgba(55, 103, 237, 0.08);
    transform: translateY(-2px);
  }

  .skill-card-icon {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 10px;
    background: var(--blue-soft);
    color: var(--blue);
    font-size: 15px;
    flex-shrink: 0;
  }

  .skill-card-body {
    min-width: 0;
  }

  .skill-card-body h3 {
    margin: 0 0 6px;
    font-size: 15px;
    font-weight: 700;
    line-height: 1.35;
    letter-spacing: -0.02em;
  }

  .skill-card-body p {
    margin: 0;
    font-size: 12px;
    line-height: 1.55;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .skill-card-go {
    color: var(--muted);
    font-size: 14px;
    padding-top: 4px;
    transition: color 0.15s, transform 0.15s;
  }

  .skill-card:hover .skill-card-go {
    color: var(--blue);
    transform: translateX(2px);
  }

  .skills-empty {
    padding: 28px;
  }

  .skills-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-top: 28px;
    padding-top: 20px;
    border-top: 1px solid var(--line);
    font-size: 11px;
    line-height: 1.6;
  }

  .skills-foot code {
    font-size: 0.95em;
  }

  @media (min-width: 1100px) {
    .skills-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 760px) {
    .skills-page {
      padding-top: 40px;
    }

    .skills-meta {
      align-items: flex-start;
      width: 100%;
      flex-direction: row;
      flex-wrap: wrap;
      align-items: center;
      gap: 8px 12px;
    }

    .skills-count-label {
      order: 3;
      width: 100%;
    }

    .skills-body--with-nav {
      grid-template-columns: 1fr;
    }

    .skills-nav {
      position: static;
      grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));
    }

    .skills-nav-title {
      grid-column: 1 / -1;
    }
  }
</style>
