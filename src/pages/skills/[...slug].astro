---
import BaseLayout from '../../layouts/BaseLayout.astro';
import MermaidInit from '../../components/MermaidInit.astro';
import { renderMarkdownDocument } from '../../lib/render-markdown';
import { loadWikiSkills, skillCategoryLabel, skillDisplayTitle } from '../../lib/wiki-skills';
import 'katex/dist/katex.min.css';

export function getStaticPaths() {
  return loadWikiSkills().map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { html, toc } = renderMarkdownDocument(entry.body);
---

<BaseLayout title={`${skillDisplayTitle(entry)} · Skill`} description={entry.summary || entry.title}>
  <article class="wrap article-page">
    <a class="back-link" href="/skills/">← 返回 Skill</a>
    <header class="article-header">
      <span class="tag">{skillCategoryLabel(entry.category)}</span>
      <span class="tag tag-muted">{entry.name}</span>
      <h1>{skillDisplayTitle(entry)}</h1>
      {entry.summary && <p class="article-intro">{entry.summary}</p>}
      <div class="byline">
        <span class="byline-avatar">SK</span>
        <span>
          <b>raw/4-Skill/{entry.slug}</b>
          <small>{entry.skillPath}</small>
        </span>
      </div>
    </header>
    <div class:list={['article-layout', { 'article-layout--no-toc': toc.length === 0 }]}>
      {toc.length > 0 && (
        <aside class="toc" aria-label="本文目录">
          <b>本文目录</b>
          <nav class="toc-nav">
            {toc.map((item) => (
              <a href={`#${item.id}`} class={`toc-link depth-${item.depth}`}>
                {item.text}
              </a>
            ))}
          </nav>
        </aside>
      )}
      <div class="article-body-content knowledge-md" set:html={html} />
    </div>
  </article>
  <MermaidInit />
</BaseLayout>
<style>
  .article-page {
    padding-top: 28px;
  }
  .back-link {
    font-size: 12px;
    color: var(--muted);
  }
  .article-header {
    max-width: 820px;
    margin: 48px auto 32px;
  }
  .article-header h1 {
    font-size: clamp(28px, 4vw, 42px);
    margin: 18px 0;
  }
  .article-intro {
    font-size: 17px;
    color: var(--muted);
    max-width: 760px;
  }
  .tag-muted {
    margin-left: 6px;
    opacity: 0.85;
  }
  .byline {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 25px;
  }
  .byline-avatar {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: var(--blue-soft);
    color: var(--blue);
    display: grid;
    place-items: center;
    font-size: 11px;
    font-weight: 800;
  }
  .byline > span:last-child {
    display: grid;
  }
  .byline b {
    font-size: 12px;
  }
  .byline small {
    font-size: 10px;
    color: var(--muted);
  }
  .article-layout {
    display: grid;
    grid-template-columns: 200px minmax(0, 1fr);
    gap: 32px;
    max-width: 980px;
    margin: 0 auto 55px;
  }
  .article-layout--no-toc {
    grid-template-columns: minmax(0, 1fr);
    max-width: 720px;
  }
  .toc {
    position: sticky;
    top: 24px;
    height: max-content;
    padding: 16px;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--surface);
    font-size: 11px;
  }
  .toc b {
    display: block;
    margin-bottom: 10px;
    font-size: 10px;
    letter-spacing: 0.06em;
    color: var(--muted);
  }
  .toc-nav {
    display: grid;
    gap: 6px;
  }
  .toc-link {
    color: var(--muted);
    line-height: 1.4;
  }
  .toc-link:hover {
    color: var(--blue);
  }
  .toc-link.depth-3 {
    padding-left: 10px;
  }
  .knowledge-md :global(h2) {
    font-size: 22px;
    margin: 28px 0 12px;
  }
  .knowledge-md :global(h3) {
    font-size: 18px;
    margin: 22px 0 10px;
  }
  .knowledge-md :global(p) {
    color: var(--muted);
    line-height: 1.85;
    font-size: 15px;
  }
  .knowledge-md :global(ul) {
    color: var(--muted);
    padding-left: 1.2em;
    line-height: 1.75;
  }
  .knowledge-md :global(a) {
    color: var(--blue);
  }
  .knowledge-md :global(pre) {
    overflow-x: auto;
    padding: 14px;
    border-radius: 10px;
    background: var(--surface-2);
    font-size: 12px;
  }
  @media (max-width: 760px) {
    .article-layout {
      grid-template-columns: 1fr;
    }
    .toc {
      display: none;
    }
  }
</style>
