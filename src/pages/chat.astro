---
import BaseLayout from "../layouts/BaseLayout.astro";import {getCollection} from "astro:content";const index=[...await getCollection("blog",({data})=>!data.draft),...await getCollection("notes",({data})=>!data.draft)].map(e=>({title:e.data.title,description:e.data.description,tags:e.data.tags,href:e.collection==="notes"?`/notes/${e.id}`:`/blog/${e.id}`}));
---
<BaseLayout title="AI Chat · Boyang Wang"><main class="container"><header class="page-head"><div class="eyebrow">Knowledge assistant</div><h1>Ask TechNotes</h1><p class="muted">Retrieves your published knowledge locally. Connect an AI proxy later to produce generated answers.</p></header><section class="chat"><div id="log" class="chat-log"><strong>Knowledge assistant</strong><p class="muted">Ask about Agent Architecture, RAG, Data Agent or Bioprocess.</p></div><form id="form"><input id="q" class="search-box" placeholder="What should I consider when designing an MCP workflow?" required/><div class="actions"><button class="button primary">Ask knowledge base</button><a class="button" href="/search">Open search</a></div></form></section></main><script define:vars={{index}}>const form=document.querySelector("#form"),q=document.querySelector("#q"),log=document.querySelector("#log");form.addEventListener("submit",e=>{e.preventDefault();const t=q.value.toLowerCase().split(/[^a-z0-9]+/).filter(x=>x.length>2);const hits=index.map(x=>({...x,s:t.reduce((n,w)=>n+((x.title+" "+x.description+" "+x.tags.join(" ")).toLowerCase().includes(w)?1:0),0)})).filter(x=>x.s).sort((a,b)=>b.s-a.s).slice(0,3);log.innerHTML="<strong>Retrieved knowledge</strong><p class='muted'>"+(hits.length?"These published notes and articles are most relevant. Add an AI server proxy when you want a synthesized LLM response.":"No matching published knowledge yet. Add a note or article first.")+"</p>"+hits.map(x=>`<p><a href="${x.href}"><strong>${x.title}</strong></a><br/><span class="muted">${x.description}</span></p>`).join("");q.value=""});</script></BaseLayout>