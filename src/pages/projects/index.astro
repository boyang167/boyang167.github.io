---
import BaseLayout from '../../layouts/BaseLayout.astro';
const projects=[
 {icon:'⌘',kind:'KNOWLEDGE SYSTEM',title:'Personal LLM Wiki',desc:'将 Markdown、PARA、Git 与 Agent Skills 结合，构建长期可维护、可检索、可持续发布的个人知识系统。',tags:['Astro','Markdown','Agent Skills'],status:'持续迭代',detail:'关注知识结构、自动整理与公开发布工作流。'},
 {icon:'◉',kind:'DATA AGENT',title:'Data Agent Research',desc:'围绕自然语言数据问答，研究 SQL 生成、语义层、工具调用、权限控制与可观测性。',tags:['Text-to-SQL','RAG','Semantic Layer'],status:'研究中',detail:'对比开源项目与可落地的企业架构方案。'},
 {icon:'⌁',kind:'BIOPROCESS ML',title:'Bioprocess Scale-up Modeling',desc:'探索配对小罐—大罐数据的建模流程，强调分组验证、OOF、独立测试集与结果可解释性。',tags:['XGBoost','Group CV','SHAP'],status:'实践研究',detail:'项目展示前请补充可公开的真实结果与脱敏案例。'},
 {icon:'▦',kind:'AGENT PLATFORM',title:'Agent Platform Architecture',desc:'研究多 Agent 协作、工具注册、工作流编排、权限体系与人机协同的工程架构。',tags:['Workflow','MCP','Observability'],status:'架构探索',detail:'目标是建立可扩展、可审计的企业级 Agent 基础能力。'},
 {icon:'⌘',kind:'PLATFORM ENGINEERING',title:'Data Platform Engineering',desc:'围绕数据集成、元数据、API 治理与自动化运维，沉淀平台工程实践与标准化方法。',tags:['Data Pipeline','API','Cloud'],status:'工程实践',detail:'适合加入架构图、关键决策与工程复盘。'},
 {icon:'✳',kind:'ML PLAYGROUND',title:'ML Experiment Playground',desc:'构建可复用的表格数据回归建模流程，涵盖数据检查、基线模型、调参、评估和模型报告。',tags:['Python','Scikit-learn','Evaluation'],status:'持续学习',detail:'适合展示可复现代码、实验记录和指标对比。'},
];
---
<BaseLayout title="项目作品集 · Boyang Wang">
  <section class="wrap page-hero"><div class="eyebrow">SELECTED WORK & EXPERIMENTS</div><h1>项目作品集</h1><p>记录我正在构建、研究和持续迭代的项目。这里不仅展示结果，也希望说明问题背景、设计思路与工程取舍。</p><div class="tag-row"><span class="tag">AI Agent</span><span class="tag">数据工程</span><span class="tag">机器学习</span><span class="tag">平台架构</span></div></section>
  <section class="wrap project-grid">{projects.map((project,i)=><article class="card work-card"><div class:list={['work-art',`work-art-${i%3}`]}><span>{project.icon}</span><div class="art-lines"></div><small>{project.kind}</small></div><div class="work-body"><div class="work-status"><span class="eyebrow">{project.kind}</span><span class="status"><i></i>{project.status}</span></div><h2>{project.title}</h2><p class="muted">{project.desc}</p><div class="tag-row">{project.tags.map(tag=><span class="skill-tag">{tag}</span>)}</div><details><summary>项目说明</summary><p class="muted">{project.detail}</p></details></div></article>)}</section>
  <section class="wrap project-cta"><div><div class="eyebrow">COLLABORATE</div><h2>有相似的问题或想法？</h2><p class="muted">欢迎交流技术方案、开源项目和工程实践。</p></div><a class="button-primary" href="/about/#contact">联系我 ↗</a></section>
</BaseLayout>
<style>
.project-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20px}.work-card{overflow:hidden}.work-art{height:170px;position:relative;display:flex;align-items:center;justify-content:center;overflow:hidden;background:linear-gradient(135deg,#101b33,#2e5397);color:#c9dcff}.work-art>span{font-size:56px;z-index:1}.work-art small{position:absolute;left:20px;bottom:15px;z-index:1;font-size:9px;letter-spacing:.12em;color:#d6e3ffb0}.art-lines{position:absolute;inset:-40%;background-image:linear-gradient(#8eb2ff20 1px,transparent 1px),linear-gradient(90deg,#8eb2ff20 1px,transparent 1px);background-size:35px 35px;transform:rotate(-20deg)}.work-art-1{background:linear-gradient(135deg,#142b3c,#236e83)}.work-art-2{background:linear-gradient(135deg,#202343,#5c5bb0)}.work-body{padding:22px}.work-status{display:flex;align-items:center;justify-content:space-between;gap:10px}.work-body h2{font-size:21px;margin:12px 0}.work-body>p{font-size:12px;min-height:42px}.work-body details{border-top:1px solid var(--line);margin-top:18px;padding-top:13px;font-size:11px}.work-body summary{cursor:pointer;color:var(--blue);font-weight:700}.work-body details p{margin:10px 0 0}.project-cta{margin-top:60px;padding:30px 34px;border-radius:20px;background:var(--surface-2);display:flex;align-items:center;justify-content:space-between;gap:20px}.project-cta h2{margin:9px 0}.project-cta p{font-size:12px;margin:0}@media(max-width:650px){.project-grid{grid-template-columns:1fr}.work-art{height:145px}.project-cta{align-items:flex-start;flex-direction:column;padding:25px}}
</style>
