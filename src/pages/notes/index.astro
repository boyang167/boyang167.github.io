---
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  categoryLabel,
  NOTE_CATEGORY_ICONS,
} from '../../lib/note-categories';
import {
  listNoteCategories,
  loadWikiNotes,
  wikiNotesAvailable,
} from '../../lib/wiki-notes';

function formatDisplayDate(value: Date | string): { label: string; iso: string } | null {
  if (typeof value === 'string') {
    const match = value.trim().match(/^(\d{4})[-/.](\d{1,2})[-/.](\d{1,2})(?:\D|$)/);
    if (match) {
      const month = match[2].padStart(2, '0');
      const day = match[3].padStart(2, '0');
      return { label: `${match[1]}.${month}.${day}`, iso: `${match[1]}-${month}-${day}` };
    }
  }
  const date = value instanceof Date ? value : new Date(value);
  if (Number.isNaN(date.getTime())) return null;
  const year = date.getUTCFullYear();
  const month = String(date.getUTCMonth() + 1).padStart(2, '0');
  const day = String(date.getUTCDate()).padStart(2, '0');
  return { label: `${year}.${month}.${day}`, iso: `${year}-${month}-${day}` };
}

const entries = loadWikiNotes().map((entry) => ({
  ...entry,
  displayDate: formatDisplayDate(entry.updated),
}));
const categories = listNoteCategories();
const submoduleReady = wikiNotesAvailable();

const catAnchor = (id: string) => `cat-${id.replace(/[^a-zA-Z0-9-]/g, '-')}`;

const byCategory = new Map<string, typeof entries>();
for (const entry of entries) {
  const list = byCategory.get(entry.category) ?? [];
  list.push(entry);
  byCategory.set(entry.category, list);
}
---
<BaseLayout
  title="学习笔记 · Boyang Wang"
  description="Markdown 个人笔记，目录与 personal-knowledge-wiki/raw/1-Note 保持一致。"
>
  <section class="wrap page-hero">
    <div class="eyebrow">MARKDOWN NOTES</div>
    <h1>学习笔记</h1>
    <p
      data-page-zh="按主题沉淀原始思考、学习路径与可复用的技术记录。"
      data-page-en="Topic-based working notes, learning paths, and reusable technical references."
    >
      按主题沉淀原始思考、学习路径与可复用的技术记录。
    </p>
  </section>
  <section class="wrap knowledge-layout">
    <aside class="knowledge-sidebar card">
      <p class="sidebar-kicker" data-page-zh="按主题浏览" data-page-en="Browse by topic">按主题浏览</p>
      <b>笔记目录</b>
      <a class="selected" href="#articles">⌂　总览</a>
      {categories.map((cat) => (
        <a href={`#${catAnchor(cat)}`}>
          {NOTE_CATEGORY_ICONS[cat] ?? '◈'}　{categoryLabel(cat)}
        </a>
      ))}
      <div class="sidebar-note">
        <span>✎</span>
        <b>{submoduleReady ? 'raw/1-Note' : '未找到笔记目录'}</b>
        <small>
          {submoduleReady
            ? `${categories.length} 个主题 · ${entries.length} 篇 Markdown`
            : '初始化 submodule 或放置 sibling wiki 仓库'}
        </small>
      </div>
    </aside>
    <div class="knowledge-main" id="articles">
      <div class="knowledge-heading">
        <div>
          <h2>全部笔记</h2>
        </div>
        <span class="tag">Markdown</span>
      </div>
      {categories.map((cat) => {
        const list = byCategory.get(cat) ?? [];
        return (
          <div class="category-block" id={catAnchor(cat)}>
            <h3>{categoryLabel(cat)}</h3>
            {list.length === 0 ? (
              <div class="category-empty">
                <p
                  class="muted"
                  data-page-zh="该主题下暂无 Markdown 文件，可在对应文件夹中添加 .md 笔记。"
                  data-page-en="No Markdown notes in this topic yet. Add a .md file in its source folder."
                >
                  该主题下暂无 Markdown 文件，可在对应文件夹中添加 .md 笔记。
                </p>
                <a
                  class="text-link"
                  href="https://github.com/boyang167/personal-knowledge-wiki"
                  rel="noopener"
                  data-page-zh="前往 Wiki 仓库 ↗"
                  data-page-en="Open Wiki repo ↗"
                >
                  前往 Wiki 仓库 ↗
                </a>
              </div>
            ) : (
              <div class="grid-2">
                {list.map((item) => (
                  <a class="card knowledge-card" href={`/notes/${item.slug}/`}>
                    <div class="knowledge-card-top">
                      <div class="card-icon">{NOTE_CATEGORY_ICONS[cat] ?? '◈'}</div>
                      <span class="knowledge-card-arrow" aria-hidden="true">↗</span>
                    </div>
                    <h3>{item.title}</h3>
                    {item.summary ? (
                      <p class="muted">{item.summary}</p>
                    ) : (
                      <p
                        class="muted"
                        data-page-zh="暂未添加摘要。"
                        data-page-en="No summary yet."
                      >
                        暂未添加摘要。
                      </p>
                    )}
                    <div class="knowledge-bottom">
                      {item.displayDate ? (
                        <time datetime={item.displayDate.iso}>{item.displayDate.label}</time>
                      ) : (
                        <span>{item.tags.slice(0, 2).join(' · ') || item.status}</span>
                      )}
                    </div>
                  </a>
                ))}
              </div>
            )}
          </div>
        );
      })}
      <div class="knowledge-banner">
        <div class="card-icon">▤</div>
        <div>
          <b>与知识库的区别</b>
          <p class="muted">
            <strong>笔记</strong> 读取 <code>raw/1-Note/</code>（个人原笔记）；<strong>知识库</strong> 读取
            <code>publish/</code>（审核后公开）。
          </p>
        </div>
        <a href="https://github.com/boyang167/personal-knowledge-wiki" rel="noopener">Wiki 仓库 ↗</a>
      </div>
    </div>
  </section>
</BaseLayout>
<script>
  const localizedText = [...document.querySelectorAll('[data-page-zh][data-page-en]')];
  const syncPageLanguage = (lang) => {
    localizedText.forEach((element) => {
      const text = lang === 'en' ? element.dataset.pageEn : element.dataset.pageZh;
      if (text) element.textContent = text;
    });
  };
  syncPageLanguage(document.documentElement.lang);
  window.addEventListener('language-change', (event) => syncPageLanguage(event.detail));
</script>
<style>
  .knowledge-layout {
    display: grid;
    grid-template-columns: 220px minmax(0, 1fr);
    gap: 32px;
    align-items: start;
    padding-bottom: 72px;
  }
  .knowledge-sidebar {
    position: sticky;
    top: 96px;
    padding: 16px;
    height: max-content;
    display: grid;
    gap: 6px;
    background: var(--surface-raised);
  }
  .sidebar-kicker {
    margin: 0 8px 10px;
    color: var(--muted);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .knowledge-sidebar > b {
    font-size: 11px;
    padding: 0 8px 6px;
  }
  .knowledge-sidebar > a {
    display: flex;
    align-items: center;
    min-height: 40px;
    padding: 8px 10px;
    border-radius: 8px;
    color: var(--muted);
    font-size: 11px;
  }
  .knowledge-sidebar > a.selected,
  .knowledge-sidebar > a:hover {
    background: var(--blue-soft);
    color: var(--blue);
  }
  .sidebar-note {
    margin-top: 20px;
    padding: 14px;
    background: var(--surface-2);
    border-radius: 10px;
    display: grid;
    gap: 4px;
  }
  .sidebar-note span {
    color: var(--blue);
  }
  .sidebar-note b {
    font-size: 11px;
  }
  .sidebar-note small {
    font-size: 10px;
    color: var(--muted);
  }
  .knowledge-heading {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 24px;
  }
  .knowledge-heading h2 {
    font-size: 22px;
    margin: 0 0 5px;
  }
  .knowledge-heading p {
    font-size: 11px;
    margin: 0;
  }
  .category-block {
    margin-bottom: 36px;
    scroll-margin-top: 100px;
  }
  .category-block > h3 {
    font-size: 14px;
    margin: 0 0 14px;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .category-empty {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 24px;
    border: 1px dashed var(--line);
    border-radius: var(--radius-md);
    background: color-mix(in srgb, var(--surface) 62%, transparent);
  }
  .category-empty p {
    margin: 0;
    font-size: 13px;
  }
  .category-empty .text-link {
    flex: 0 0 auto;
  }
  .knowledge-card {
    display: flex;
    min-width: 0;
    min-height: 196px;
    flex-direction: column;
    padding: 18px;
    transition: transform 0.2s, border-color 0.2s, box-shadow 0.2s;
  }
  .knowledge-card:hover {
    transform: translateY(-3px);
  }
  .knowledge-card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 14px;
  }
  .knowledge-card .card-icon {
    width: 36px;
    height: 36px;
    margin: 0;
    border-radius: 10px;
    font-size: 16px;
  }
  .knowledge-card-arrow {
    color: var(--muted);
    font-size: 13px;
  }
  .knowledge-card h3 {
    margin: 0 0 8px;
    font-size: 16px;
  }
  .knowledge-card p {
    display: -webkit-box;
    min-height: 0;
    margin: 0 0 16px;
    overflow: hidden;
    font-size: 12px;
    line-height: 1.6;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
  }
  .knowledge-bottom {
    display: flex;
    justify-content: space-between;
    border-top: 1px solid var(--line);
    margin-top: auto;
    padding-top: 12px;
    font-size: 11px;
    color: var(--muted);
  }
  .knowledge-bottom time {
    font-variant-numeric: tabular-nums;
  }
  .empty-card {
    padding: 24px;
  }
  .knowledge-banner {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-top: 20px;
    padding: 18px;
    border: 1px solid var(--line);
    border-radius: 15px;
    background: transparent;
    color: var(--muted);
  }
  .knowledge-banner .card-icon {
    margin: 0;
    flex-shrink: 0;
  }
  .knowledge-banner > div:nth-child(2) {
    flex: 1;
  }
  .knowledge-banner b {
    font-size: 12px;
  }
  .knowledge-banner p {
    font-size: 10px;
    margin: 4px 0 0;
  }
  .knowledge-banner > a {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    font-size: 11px;
    color: var(--blue);
    font-weight: 700;
    white-space: nowrap;
  }
  .page-hero code {
    font-size: 0.9em;
  }
  @media (max-width: 760px) {
    .knowledge-layout {
      grid-template-columns: 1fr;
    }
    .knowledge-sidebar {
      position: static;
      display: flex;
      overflow-x: auto;
      padding: 10px;
      gap: 6px;
      scrollbar-width: thin;
    }
    .sidebar-kicker,
    .knowledge-sidebar > b,
    .sidebar-note {
      display: none;
    }
    .knowledge-sidebar > a {
      flex: 0 0 auto;
      white-space: nowrap;
    }
    .knowledge-banner {
      align-items: flex-start;
      flex-wrap: wrap;
    }
    .knowledge-banner > a {
      margin-left: 0;
    }
    .category-empty {
      align-items: flex-start;
      flex-direction: column;
      gap: 8px;
    }
  }
</style>
