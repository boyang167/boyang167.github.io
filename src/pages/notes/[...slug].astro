---
import { getCollection, render } from "astro:content";

import KnowledgeLayout from "../../layouts/KnowledgeLayout.astro";
import {
  buildKnowledgeTree,
  findAdjacent,
  findTranslation,
} from "../../lib/knowledge.mjs";

export async function getStaticPaths() {
  const entries = await getCollection("notes", ({ data }) => !data.draft);
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry, entries },
  }));
}

const { entry, entries } = Astro.props;
const { Content, headings } = await render(entry);
const tree = buildKnowledgeTree(entries);
const translation = findTranslation(entry, entries);
const { previous, next } = findAdjacent(entry, entries);
---

<KnowledgeLayout
  entry={entry}
  tree={tree}
  headings={headings}
  translation={translation}
  previous={previous}
  next={next}
>
  <Content />
</KnowledgeLayout>