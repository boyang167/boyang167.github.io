---
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  blogFeaturedEyebrow,
  blogPostHref,
  formatBlogDateDots,
  getFeaturedBlogPosts,
} from '../lib/blog';

const featuredPosts = await getFeaturedBlogPosts(3);
const featured = featuredPosts.map((post) => ({
  tag: blogFeaturedEyebrow(post.data.category),
  title: post.data.title,
  desc: post.data.description,
  date: formatBlogDateDots(post.data.date),
  icon: post.data.icon,
  href: blogPostHref(post),
  readTime: post.data.readTime,
}));
const latestPostHref = featured[0]?.href ?? '/blog/';
---
<BaseLayout title="Boyang Wang · Agent & Data Platform Engineering" description="个人技术门户，记录 Agent、数据平台、DevOps、机器学习、深度学习与 CMC 生物制药实践。">
  <section class="wrap home-intro home-one-screen" id="top">
    <div class="home-hero home-hero-compact">
      <div class="hero-copy">
        <div class="eyebrow">AGENT · DATA PLATFORM · DEVOPS · ML · DEEP LEARNING · CMC</div>
        <p class="hero-lead muted">
          具备 AI Agent &amp; Harness Engineering、Data Platform、云原生 DevOps 及 Machine Learning / Deep Learning 的综合技术能力，聚焦 CMC 生物制药领域的数字化与智能化建设。
        </p>
        <div class="hero-actions">
          <a class="button-primary" href={latestPostHref}>阅读最新文章 <span>↗</span></a>
          <a class="button-secondary" href="/blog/">全部文章</a>
        </div>
        <div class="project-overview">
          <div class="project-overview-head">
            <span class="eyebrow">PERSONAL KNOWLEDGE SYSTEM</span>
          </div>
          <div class="project-links">
            <a href="/notes/"><span><b>笔记</b><small>原始学习记录</small></span><i>↗</i></a>
            <a href="/knowledge/"><span><b>知识库</b><small>审核后的专题知识</small></span><i>↗</i></a>
            <a href="/blog/"><span><b>技术博客</b><small>实践、思考与取舍</small></span><i>↗</i></a>
            <a href="/skills/"><span><b>Skill</b><small>可复用的 Agent 工作流</small></span><i>↗</i></a>
          </div>
        </div>
      </div>
      <div class="hero-visual">
        <div class="portrait-placeholder">
          <div class="portrait-grid"></div>
          <div class="portrait-orbit orbit-one"></div>
          <div class="portrait-orbit orbit-two"></div>
          <div class="visual-meta">
            <span>KNOWLEDGE SYSTEM</span>
            <b>04 MODULES</b>
          </div>
          <div class="avatar-monogram">BW</div>
          <div class="visual-chip">
            <i></i>
            <span><small>CURRENT FOCUS</small>AGENT · PLATFORM · DEVOPS · ML · DL · CMC</span>
          </div>
        </div>
        <div class="visual-caption">Curiosity → Experiments → Reliable Systems</div>
      </div>
    </div>

    <div class="hero-writing">
      <div class="section-head section-head-compact">
        <div>
          <div class="eyebrow">SELECTED WRITING</div>
          <h2>最近在思考什么</h2>
        </div>
        <a class="text-link" href="/blog/">全部文章 ↗</a>
      </div>
      <div class="grid-3">
        {featured.map((item, index) => (
          <a class="card article-card" href={item.href}>
            <div class:list={['article-art', `article-art-${index + 1}`]}>
              <span class="article-index">0{index + 1}</span>
              <span class="article-icon">{item.icon}</span>
              <i></i>
              <i></i>
            </div>
            <div class="article-body">
              <span class="eyebrow">{item.tag}</span>
              <h3>{item.title}</h3>
              <p class="muted">{item.desc}</p>
              <div class="card-meta">
                <span>{item.date}</span>
                <span>阅读 {item.readTime} ↗</span>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
<style>
  :global(body:has(.home-one-screen) .brand) {
    min-height: 40px;
  }
  .home-intro {
    padding: clamp(18px, 2.4vh, 28px) 0 0;
  }
  .home-hero-compact {
    display: grid;
    grid-template-columns: minmax(0, 1.16fr) minmax(300px, 0.84fr);
    align-items: center;
    gap: clamp(32px, 4.5vw, 64px);
    padding: 0 0 clamp(16px, 2.2vh, 24px);
  }
  .hero-copy .eyebrow {
    max-width: 46rem;
    margin-bottom: 12px;
    color: var(--blue-strong);
    line-height: 1.6;
  }
  .hero-lead {
    margin: 10px 0 18px;
    max-width: 40rem;
    font-size: clamp(15px, 1.4vw, 18px);
    line-height: 1.72;
    text-wrap: pretty;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .project-overview {
    margin-top: 20px;
    padding-top: 16px;
    border-top: 1px solid var(--line);
  }
  .project-overview-head {
    display: flex;
    justify-content: space-between;
    gap: 24px;
    align-items: baseline;
    margin-bottom: 9px;
  }
  .project-overview-head p {
    max-width: 28rem;
    margin: 0;
    color: var(--muted);
    font-size: 11px;
    line-height: 1.65;
  }
  .project-links {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
  }
  .project-links a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-width: 0;
    min-height: 76px;
    gap: 14px;
    padding: 16px 18px;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: var(--surface);
    box-shadow: var(--shadow-sm);
    transition: border-color 0.2s, background 0.2s, transform 0.2s;
  }
  .project-links a:hover {
    transform: translateY(-1px);
    border-color: color-mix(in srgb, var(--blue) 32%, var(--line));
    background: var(--surface-raised);
  }
  .project-links span {
    display: grid;
    min-width: 0;
    gap: 4px;
  }
  .project-links b {
    font-size: 13px;
    line-height: 1.25;
  }
  .project-links small {
    color: var(--muted);
    font-size: 10px;
    line-height: 1.45;
  }
  .project-links i {
    flex: 0 0 auto;
    color: var(--blue);
    font-size: 12px;
    font-style: normal;
  }
  .hero-visual {
    padding: 0;
    position: relative;
    max-width: 360px;
    justify-self: end;
    width: 100%;
  }
  .portrait-placeholder {
    position: relative;
    height: clamp(240px, 26vw, 300px);
    overflow: hidden;
    display: grid;
    place-items: center;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background:
      radial-gradient(circle at 52% 42%, color-mix(in srgb, var(--surface) 94%, transparent) 0 11%, transparent 36%),
      linear-gradient(145deg, var(--surface-raised), color-mix(in srgb, var(--blue-soft) 72%, var(--surface)));
    box-shadow: var(--shadow-lg);
  }
  :global(.dark) .portrait-placeholder {
    border-color: var(--line);
    background:
      radial-gradient(circle at 52% 42%, color-mix(in srgb, var(--surface-raised) 88%, transparent) 0 11%, transparent 36%),
      linear-gradient(145deg, var(--surface-raised), color-mix(in srgb, var(--blue-soft) 26%, var(--surface)));
  }
  .portrait-grid {
    position: absolute;
    inset: 0;
    opacity: 0.18;
    background-image:
      linear-gradient(color-mix(in srgb, var(--blue) 18%, transparent) 1px, transparent 1px),
      linear-gradient(90deg, color-mix(in srgb, var(--blue) 18%, transparent) 1px, transparent 1px);
    background-size: 42px 42px;
    mask-image: linear-gradient(to bottom right, transparent, #000 45%, transparent);
  }
  .visual-meta {
    position: absolute;
    z-index: 3;
    top: 22px;
    left: 22px;
    display: grid;
    gap: 2px;
    color: #45609d;
  }
  :global(.dark) .visual-meta {
    color: #aebfff;
  }
  .visual-meta span {
    font-size: 7px;
    font-weight: 700;
    letter-spacing: 0.14em;
  }
  .visual-meta b {
    font-size: 11px;
    letter-spacing: 0.04em;
  }
  .avatar-monogram {
    position: relative;
    z-index: 2;
    width: clamp(96px, 11vw, 124px);
    height: clamp(96px, 11vw, 124px);
    display: grid;
    place-items: center;
    border: 1px solid rgba(255, 255, 255, 0.85);
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.46);
    color: #3551a0;
    font-size: clamp(32px, 3.5vw, 44px);
    font-weight: 800;
    letter-spacing: -0.09em;
    box-shadow: 0 22px 60px rgba(44, 72, 141, 0.16);
    backdrop-filter: blur(12px);
  }
  :global(.dark) .avatar-monogram {
    background: rgba(32, 47, 80, 0.68);
    color: #b9c9ff;
    border-color: rgba(255, 255, 255, 0.16);
  }
  .portrait-orbit {
    position: absolute;
    border: 1px solid rgba(255, 255, 255, 0.72);
    border-radius: 50%;
  }
  .orbit-one {
    width: clamp(180px, 20vw, 230px);
    height: clamp(180px, 20vw, 230px);
  }
  .orbit-two {
    width: clamp(250px, 28vw, 320px);
    height: clamp(250px, 28vw, 320px);
    border-color: rgba(255, 255, 255, 0.42);
  }
  .visual-chip {
    position: absolute;
    z-index: 3;
    left: 20px;
    bottom: 20px;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 13px;
    border: 1px solid rgba(255, 255, 255, 0.82);
    border-radius: 14px;
    background: rgba(255, 255, 255, 0.72);
    color: #26395f;
    font-size: 11px;
    font-weight: 700;
    box-shadow: 0 12px 35px rgba(44, 72, 141, 0.12);
    backdrop-filter: blur(14px);
  }
  :global(.dark) .visual-chip {
    background: rgba(24, 36, 58, 0.78);
    color: var(--text);
    border-color: rgba(255, 255, 255, 0.12);
  }
  .visual-chip i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #4aaf82;
    box-shadow: 0 0 0 4px rgba(74, 175, 130, 0.12);
  }
  .visual-chip span {
    display: grid;
  }
  .visual-chip small {
    margin-bottom: 1px;
    color: var(--muted);
    font-size: 7px;
    letter-spacing: 0.12em;
  }
  .visual-caption {
    text-align: left;
    font-size: 10px;
    color: var(--muted);
    margin-top: 12px;
    letter-spacing: 0.08em;
  }
  .hero-writing {
    padding-top: clamp(18px, 2.5vh, 26px);
    border-top: 1px solid var(--line);
  }
  .section-head-compact {
    margin-bottom: 12px;
  }
  .section-head-compact h2 {
    margin: 6px 0 0;
    font-size: clamp(20px, 2vw, 25px);
  }
  .article-card {
    overflow: hidden;
    display: flex;
    min-width: 0;
    height: 100%;
    flex-direction: column;
    background: var(--surface);
    box-shadow: var(--shadow-sm);
    transition: transform 0.2s, border-color 0.2s, box-shadow 0.2s;
  }
  .article-card:hover {
    transform: translateY(-3px);
    border-color: color-mix(in srgb, var(--blue) 26%, var(--line));
    box-shadow: var(--shadow-md);
  }
  .article-art {
    position: relative;
    min-height: 88px;
    overflow: hidden;
    padding: 13px 16px;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    border-bottom: 1px solid var(--line);
  }
  .article-art-1 {
    background: linear-gradient(145deg, #192848, #294d90);
  }
  .article-art-2 {
    background: linear-gradient(145deg, #24345f, #526cb2);
  }
  .article-art-3 {
    background: linear-gradient(145deg, #173d58, #287a91);
  }
  .article-index {
    position: relative;
    z-index: 2;
    color: rgba(255, 255, 255, 0.62);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.12em;
  }
  .article-icon {
    position: relative;
    z-index: 2;
    width: 32px;
    height: 32px;
    display: grid;
    place-items: center;
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.22);
    color: #d8e3ff;
    font-size: 15px;
    backdrop-filter: blur(10px);
  }
  .article-art > i {
    position: absolute;
    width: 150px;
    height: 150px;
    right: 15%;
    top: -70%;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 44px;
    transform: rotate(35deg);
  }
  .article-art > i:last-child {
    width: 220px;
    height: 220px;
    right: 32%;
    top: -105%;
    transform: rotate(58deg);
  }
  .article-body {
    display: flex;
    flex: 1;
    min-width: 0;
    flex-direction: column;
    padding: 16px 18px 17px;
  }
  .article-body h3 {
    display: -webkit-box;
    overflow: hidden;
    min-height: 2.8em;
    margin: 8px 0 7px;
    font-size: 15px;
    line-height: 1.4;
    text-wrap: pretty;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }
  .article-body p {
    display: -webkit-box;
    overflow: hidden;
    min-height: 3.2em;
    margin: 0 0 12px;
    font-size: 11px;
    line-height: 1.6;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }
  .card-meta {
    display: flex;
    justify-content: space-between;
    gap: 8px;
    margin-top: auto;
    padding-top: 11px;
    border-top: 1px solid var(--line);
    font-size: 10px;
    color: var(--muted);
  }
  @media (min-width: 901px) {
    :global(body:has(.home-one-screen) .site-footer) {
      margin-top: 24px;
      padding: 14px 0 18px;
    }
  }
  @media (max-width: 900px) {
    .home-hero-compact {
      grid-template-columns: 1fr;
      gap: 24px;
    }
    .hero-visual {
      max-width: 560px;
      justify-self: stretch;
    }
    .portrait-placeholder {
      height: 300px;
    }
    .hero-writing .grid-3 {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .article-card:last-child {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 760px) {
    .home-intro {
      padding-top: 24px;
    }
    .project-overview-head {
      display: grid;
      gap: 7px;
    }
    .portrait-placeholder {
      height: 260px;
      border-radius: 24px;
    }
    .hero-writing .grid-3 {
      grid-template-columns: 1fr;
    }
    .article-card:last-child {
      grid-column: auto;
    }
  }
  @media (max-width: 480px) {
    .project-links {
      grid-template-columns: 1fr;
    }
    .project-links a {
      padding-inline: 16px;
    }
    .visual-chip {
      right: 16px;
      left: 16px;
      min-width: 0;
    }
    .visual-chip span {
      min-width: 0;
      overflow-wrap: anywhere;
    }
    .card-meta {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>
