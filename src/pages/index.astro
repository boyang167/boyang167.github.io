---
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  blogFeaturedEyebrow,
  blogPostHref,
  formatBlogDateDots,
  getFeaturedBlogPosts,
} from '../lib/blog';

const featuredPosts = await getFeaturedBlogPosts(3);
const featured = featuredPosts.map((post) => ({
  tag: blogFeaturedEyebrow(post.data.category),
  title: post.data.title,
  desc: post.data.description,
  date: formatBlogDateDots(post.data.date),
  icon: post.data.icon,
  href: blogPostHref(post),
  readTime: post.data.readTime,
}));
const latestPostHref = featured[0]?.href ?? '/blog/';
---
<BaseLayout title="Boyang Wang · AI & Data Engineering" description="个人技术门户，记录 AI Agent、数据工程、机器学习与平台架构实践。">
  <section class="wrap home-intro home-one-screen" id="top">
    <div class="home-hero home-hero-compact">
      <div class="hero-copy">
        <div class="eyebrow">AI ENGINEERING · DATA SYSTEMS · MACHINE LEARNING</div>
        <p class="hero-lead muted">
          构建 AI Agent、数据系统和机器学习的技术实践者。
        </p>
        <div class="hero-actions">
          <a class="button-primary" href={latestPostHref}>阅读最新文章 <span>↗</span></a>
          <a class="button-secondary" href="/blog/">全部文章</a>
        </div>
        <p class="hero-note">工程实践 · 持续研究 · 开放分享</p>
        <div class="project-overview">
          <div class="project-overview-head">
            <span class="eyebrow">PERSONAL KNOWLEDGE SYSTEM</span>
            <p>连接学习记录、审核知识、技术写作与 Agent Skill，构建可持续迭代的个人知识系统。</p>
          </div>
          <div class="project-links">
            <a href="/notes/"><span><b>笔记</b><small>原始学习记录</small></span><i>↗</i></a>
            <a href="/knowledge/"><span><b>知识库</b><small>审核后的专题知识</small></span><i>↗</i></a>
            <a href="/blog/"><span><b>技术博客</b><small>实践、思考与取舍</small></span><i>↗</i></a>
            <a href="/skills/"><span><b>Skill</b><small>可复用的 Agent 工作流</small></span><i>↗</i></a>
          </div>
        </div>
      </div>
      <div class="hero-visual">
        <div class="portrait-placeholder">
          <div class="portrait-grid"></div>
          <div class="portrait-orbit orbit-one"></div>
          <div class="portrait-orbit orbit-two"></div>
          <div class="visual-meta">
            <span>KNOWLEDGE SYSTEM</span>
            <b>04 MODULES</b>
          </div>
          <div class="avatar-monogram">BW</div>
          <div class="visual-chip">
            <i></i>
            <span><small>CURRENT FOCUS</small>AI · DATA · ML</span>
          </div>
        </div>
        <div class="visual-caption">Curiosity → Experiments → Reliable Systems</div>
      </div>
    </div>

    <div class="hero-writing">
      <div class="section-head section-head-compact">
        <div>
          <div class="eyebrow">SELECTED WRITING</div>
          <h2>最近在思考什么</h2>
        </div>
        <a class="text-link" href="/blog/">全部文章 ↗</a>
      </div>
      <div class="grid-3">
        {featured.map((item, index) => (
          <a class="card article-card" href={item.href}>
            <div class:list={['article-art', `article-art-${index + 1}`]}>
              <span class="article-index">0{index + 1}</span>
              <span class="article-icon">{item.icon}</span>
              <i></i>
              <i></i>
            </div>
            <div class="article-body">
              <span class="eyebrow">{item.tag}</span>
              <h3>{item.title}</h3>
              <p class="muted">{item.desc}</p>
              <div class="card-meta">
                <span>{item.date}</span>
                <span>阅读 {item.readTime} ↗</span>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
<style>
  .home-intro {
    padding: clamp(20px, 3vh, 32px) 0 0;
  }
  .home-hero-compact {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(300px, 0.8fr);
    align-items: center;
    gap: clamp(36px, 5vw, 72px);
    padding: 0 0 clamp(18px, 2.5vh, 26px);
  }
  .hero-copy .eyebrow {
    margin-bottom: 14px;
  }
  .hero-lead {
    margin: 12px 0 16px;
    max-width: 38rem;
    font-size: clamp(15px, 1.4vw, 18px);
    line-height: 1.7;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .hero-note {
    margin: 14px 0 0;
    color: var(--muted);
    font-size: 11px;
    letter-spacing: 0.08em;
  }
  .project-overview {
    margin-top: 18px;
    padding-top: 15px;
    border-top: 1px solid var(--line);
  }
  .project-overview-head {
    display: flex;
    justify-content: space-between;
    gap: 24px;
    align-items: baseline;
    margin-bottom: 9px;
  }
  .project-overview-head p {
    max-width: 28rem;
    margin: 0;
    color: var(--muted);
    font-size: 11px;
    line-height: 1.65;
  }
  .project-links {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px;
  }
  .project-links a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 8px 11px;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: color-mix(in srgb, var(--surface) 78%, transparent);
    transition: border-color 0.2s, background 0.2s, transform 0.2s;
  }
  .project-links a:hover {
    transform: translateY(-2px);
    border-color: color-mix(in srgb, var(--blue) 32%, var(--line));
    background: var(--surface);
  }
  .project-links span {
    display: grid;
    gap: 1px;
  }
  .project-links b {
    font-size: 11px;
  }
  .project-links small {
    color: var(--muted);
    font-size: 9px;
  }
  .project-links i {
    color: var(--blue);
    font-size: 10px;
    font-style: normal;
  }
  .hero-visual {
    padding: 0;
    position: relative;
    max-width: 360px;
    justify-self: end;
    width: 100%;
  }
  .portrait-placeholder {
    position: relative;
    height: clamp(240px, 26vw, 300px);
    overflow: hidden;
    display: grid;
    place-items: center;
    border: 1px solid rgba(91, 122, 205, 0.16);
    border-radius: 30px;
    background:
      radial-gradient(circle at 52% 42%, rgba(255, 255, 255, 0.96) 0 11%, transparent 36%),
      linear-gradient(145deg, #edf2ff 0%, #dbe5ff 50%, #cbd8f5 100%);
    box-shadow: 0 28px 80px rgba(55, 80, 145, 0.14);
  }
  :global(.dark) .portrait-placeholder {
    border-color: var(--line);
    background:
      radial-gradient(circle at 52% 42%, rgba(68, 84, 124, 0.72) 0 11%, transparent 36%),
      linear-gradient(145deg, #202d48, #18243a);
  }
  .portrait-grid {
    position: absolute;
    inset: 0;
    opacity: 0.23;
    background-image:
      linear-gradient(rgba(55, 103, 237, 0.16) 1px, transparent 1px),
      linear-gradient(90deg, rgba(55, 103, 237, 0.16) 1px, transparent 1px);
    background-size: 42px 42px;
    mask-image: linear-gradient(to bottom right, transparent, #000 45%, transparent);
  }
  .visual-meta {
    position: absolute;
    z-index: 3;
    top: 22px;
    left: 22px;
    display: grid;
    gap: 2px;
    color: #45609d;
  }
  :global(.dark) .visual-meta {
    color: #aebfff;
  }
  .visual-meta span {
    font-size: 7px;
    font-weight: 700;
    letter-spacing: 0.14em;
  }
  .visual-meta b {
    font-size: 11px;
    letter-spacing: 0.04em;
  }
  .avatar-monogram {
    position: relative;
    z-index: 2;
    width: clamp(96px, 11vw, 124px);
    height: clamp(96px, 11vw, 124px);
    display: grid;
    place-items: center;
    border: 1px solid rgba(255, 255, 255, 0.85);
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.46);
    color: #3551a0;
    font-size: clamp(32px, 3.5vw, 44px);
    font-weight: 800;
    letter-spacing: -0.09em;
    box-shadow: 0 22px 60px rgba(44, 72, 141, 0.16);
    backdrop-filter: blur(12px);
  }
  :global(.dark) .avatar-monogram {
    background: rgba(32, 47, 80, 0.68);
    color: #b9c9ff;
    border-color: rgba(255, 255, 255, 0.16);
  }
  .portrait-orbit {
    position: absolute;
    border: 1px solid rgba(255, 255, 255, 0.72);
    border-radius: 50%;
  }
  .orbit-one {
    width: clamp(180px, 20vw, 230px);
    height: clamp(180px, 20vw, 230px);
  }
  .orbit-two {
    width: clamp(250px, 28vw, 320px);
    height: clamp(250px, 28vw, 320px);
    border-color: rgba(255, 255, 255, 0.42);
  }
  .visual-chip {
    position: absolute;
    z-index: 3;
    left: 20px;
    bottom: 20px;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 13px;
    border: 1px solid rgba(255, 255, 255, 0.82);
    border-radius: 14px;
    background: rgba(255, 255, 255, 0.72);
    color: #26395f;
    font-size: 11px;
    font-weight: 700;
    box-shadow: 0 12px 35px rgba(44, 72, 141, 0.12);
    backdrop-filter: blur(14px);
  }
  :global(.dark) .visual-chip {
    background: rgba(24, 36, 58, 0.78);
    color: var(--text);
    border-color: rgba(255, 255, 255, 0.12);
  }
  .visual-chip i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #4aaf82;
    box-shadow: 0 0 0 4px rgba(74, 175, 130, 0.12);
  }
  .visual-chip span {
    display: grid;
  }
  .visual-chip small {
    margin-bottom: 1px;
    color: var(--muted);
    font-size: 7px;
    letter-spacing: 0.12em;
  }
  .visual-caption {
    text-align: left;
    font-size: 10px;
    color: var(--muted);
    margin-top: 12px;
    letter-spacing: 0.08em;
  }
  .hero-writing {
    padding-top: clamp(18px, 2.5vh, 26px);
    border-top: 1px solid var(--line);
  }
  .section-head-compact {
    margin-bottom: 12px;
  }
  .section-head-compact h2 {
    margin: 6px 0 0;
    font-size: clamp(20px, 2vw, 25px);
  }
  .article-card {
    overflow: hidden;
    transition: transform 0.2s, border-color 0.2s, box-shadow 0.2s;
  }
  .article-card:hover {
    transform: translateY(-3px);
    border-color: color-mix(in srgb, var(--blue) 26%, var(--line));
    box-shadow: 0 18px 45px rgba(24, 36, 59, 0.09);
  }
  .article-art {
    position: relative;
    min-height: 74px;
    overflow: hidden;
    padding: 13px 16px;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    border-bottom: 1px solid var(--line);
  }
  .article-art-1 {
    background: linear-gradient(145deg, #192848, #294d90);
  }
  .article-art-2 {
    background: linear-gradient(145deg, #24345f, #526cb2);
  }
  .article-art-3 {
    background: linear-gradient(145deg, #173d58, #287a91);
  }
  .article-index {
    position: relative;
    z-index: 2;
    color: rgba(255, 255, 255, 0.62);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.12em;
  }
  .article-icon {
    position: relative;
    z-index: 2;
    width: 32px;
    height: 32px;
    display: grid;
    place-items: center;
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.22);
    color: #d8e3ff;
    font-size: 15px;
    backdrop-filter: blur(10px);
  }
  .article-art > i {
    position: absolute;
    width: 150px;
    height: 150px;
    right: 15%;
    top: -70%;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 44px;
    transform: rotate(35deg);
  }
  .article-art > i:last-child {
    width: 220px;
    height: 220px;
    right: 32%;
    top: -105%;
    transform: rotate(58deg);
  }
  .article-body {
    padding: 14px 16px;
  }
  .article-body h3 {
    margin: 7px 0 5px;
    font-size: 15px;
    line-height: 1.3;
  }
  .article-body p {
    display: -webkit-box;
    overflow: hidden;
    margin-bottom: 9px;
    font-size: 10px;
    line-height: 1.6;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    min-height: 32px;
  }
  .card-meta {
    display: flex;
    justify-content: space-between;
    gap: 8px;
    padding-top: 9px;
    border-top: 1px solid var(--line);
    font-size: 10px;
    color: var(--muted);
  }
  @media (min-width: 901px) {
    :global(body:has(.home-one-screen) .site-footer) {
      margin-top: 24px;
      padding: 14px 0 18px;
    }
  }
  @media (max-width: 900px) {
    .home-hero-compact {
      grid-template-columns: 1fr;
      gap: 24px;
    }
    .hero-visual {
      max-width: 560px;
      justify-self: stretch;
    }
    .portrait-placeholder {
      height: 300px;
    }
  }
  @media (max-width: 760px) {
    .home-intro {
      padding-top: 20px;
    }
    .hero-proof {
      gap: 14px;
    }
    .home-intro {
      padding-top: 36px;
    }
    .project-overview-head {
      display: grid;
      gap: 7px;
    }
    .portrait-placeholder {
      height: 260px;
      border-radius: 24px;
    }
  }
  @media (max-width: 480px) {
    .project-links {
      grid-template-columns: 1fr;
    }
  }
</style>
