---
import BaseLayout from "../layouts/BaseLayout.astro";import PostCard from "../components/PostCard.astro";import {getCollection} from "astro:content";const posts=(await getCollection("blog",({data})=>!data.draft)).sort((a,b)=>b.data.date.valueOf()-a.data.date.valueOf()).slice(0,3);
---
<BaseLayout><main class="container"><section class="hero"><div><div class="eyebrow">Personal AI Knowledge Hub</div><h1>AI · Data · Agent<br/>Architecture</h1><p class="lead">I build AI agents, data platforms and intelligent systems — then turn the work into reusable technical knowledge.</p><div class="actions"><a class="button primary" href="/blog">Read the blog</a><a class="button" href="https://github.com/boyang167">GitHub</a></div></div><aside class="stat-card"><div class="eyebrow">Knowledge system</div><strong>V4</strong><p class="muted">Blog, notes, projects, retrieval and an AI-ready chat interface in one static site.</p></aside></section><section class="section"><div class="section-head"><h2>Focus areas</h2><span class="muted">Technical assets, compounded.</span></div><div class="grid"><a class="card" href="/blog"><div class="meta">AI AGENT</div><h3>Agent Architecture</h3><p>Multi-agent systems, MCP and workflow design.</p></a><a class="card" href="/blog"><div class="meta">DATA</div><h3>Data Intelligence</h3><p>Data agents, RAG, Text2SQL and platforms.</p></a><a class="card" href="/blog"><div class="meta">BIOPROCESS</div><h3>Process Modeling</h3><p>DO models, scale-up and applied XGBoost.</p></a></div></section><section class="section"><div class="section-head"><h2>Latest articles</h2><a class="muted" href="/blog">View all →</a></div><div class="grid">{posts.map(post=><PostCard entry={post}/>)}</div></section></main></BaseLayout>