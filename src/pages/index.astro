---
import { getCollection } from "astro:content";

import PostCard from "../components/PostCard.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const posts = (await getCollection("blog", ({ data }) => !data.draft))
  .sort((left, right) => right.data.date.valueOf() - left.data.date.valueOf())
  .slice(0, 3);
const knowledgeCount = (
  await getCollection("notes", ({ data }) => !data.draft)
).length;
---

<BaseLayout>
  <main class="container">
    <section class="hero">
      <div>
        <div class="eyebrow">Personal AI Knowledge Hub</div>
        <h1>AI · Data · Agent<br />Architecture</h1>
        <p class="lead">
          I build AI agents, data platforms and intelligent systems — then
          turn the work into reusable technical knowledge.
        </p>
        <div class="actions">
          <a class="button primary" href="/notes">Explore knowledge</a>
          <a class="button" href="/search">Search {knowledgeCount} documents</a>
          <a class="button" href="https://github.com/boyang167">GitHub</a>
        </div>
      </div>
      <aside class="stat-card">
        <div class="eyebrow">Knowledge system</div>
        <strong>{knowledgeCount}</strong>
        <p class="muted">
          Bilingual technical documents with structured navigation and
          full-text search.
        </p>
      </aside>
    </section>
    <section class="section">
      <div class="section-head">
        <h2>Focus areas</h2>
        <span class="muted">Technical assets, compounded.</span>
      </div>
      <div class="grid">
        <a class="card" href="/notes">
          <div class="meta">AI AGENT</div>
          <h3>Agent Architecture</h3>
          <p>Multi-agent systems, MCP and workflow design.</p>
        </a>
        <a class="card" href="/notes">
          <div class="meta">DATA</div>
          <h3>Data Intelligence</h3>
          <p>Data agents, RAG, Text2SQL and platforms.</p>
        </a>
        <a class="card" href="/notes">
          <div class="meta">ENGINEERING</div>
          <h3>Architecture & SRE</h3>
          <p>System design, delivery, operations and reliability.</p>
        </a>
      </div>
    </section>
    <section class="section">
      <div class="section-head">
        <h2>Latest articles</h2>
        <a class="muted" href="/blog">View all →</a>
      </div>
      <div class="grid">
        {posts.map((post) => <PostCard entry={post} />)}
      </div>
    </section>
  </main>
</BaseLayout>